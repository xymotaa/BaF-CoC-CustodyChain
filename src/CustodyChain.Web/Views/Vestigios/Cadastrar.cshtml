@model CustodyChain.Web.Models.ViewModels.CadastroVestigioViewModel
@{
    ViewData["Title"] = "Cadastro de vestígio";
}

<div class="pagina-cabecalho pagina-cabecalho-acoes">
    <div><h1>Cadastro de vestígio</h1></div>
    <nav class="navegacao-operacional" aria-label="Navegação da cadeia de custódia">
        <a class="botao botao--secundario" href="/auditoria">Consultar histórico</a>
    </nav>
</div>

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagem</span>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>Verifique os campos destacados abaixo.</span>
    </div>
}

<form id="cadastro-vestigio-form" novalidate class="formulario-operacional" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <section class="cartao secao-operacional">
        <h2>Lacre Digital</h2>
        <p class="campo-ajuda secao-formulario-intro">Conjunto mínimo gravado na credencial de cadeia de custódia (decisão D-13).</p>

        <div class="grade-operacional">
            <div class="campo">
                <label asp-for="RotuloEvidencia" class="campo-rotulo"></label>
                <input asp-for="RotuloEvidencia" class="campo-entrada mono @(ViewData.ModelState["RotuloEvidencia"]?.Errors.Count > 0 ? "campo-invalido" : "")" />
                <span asp-validation-for="RotuloEvidencia" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="RotuloConjunto" class="campo-rotulo"></label>
                <input asp-for="RotuloConjunto" class="campo-entrada mono @(ViewData.ModelState["RotuloConjunto"]?.Errors.Count > 0 ? "campo-invalido" : "")" />
                <span asp-validation-for="RotuloConjunto" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="NumeroEvidencia" class="campo-rotulo"></label>
                <input asp-for="NumeroEvidencia" class="campo-entrada" />
                <span asp-validation-for="NumeroEvidencia" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="ProcessoId" class="campo-rotulo"></label>
                <select asp-for="ProcessoId" class="campo-entrada @(ViewData.ModelState["ProcessoId"]?.Errors.Count > 0 ? "campo-invalido" : "")">
                    <option value="">Selecione o processo</option>
                    @foreach (var opcao in Model.ProcessosDisponiveis)
                    {
                        <option value="@opcao.Id">@opcao.Numero @(opcao.NomeOperacao is not null ? $"— {opcao.NomeOperacao}" : "")</option>
                    }
                </select>
                <span asp-validation-for="ProcessoId" class="campo-erro"></span>
            </div>
        </div>

        <div class="campo">
            <label asp-for="Descricao" class="campo-rotulo"></label>
            <textarea asp-for="Descricao" rows="4" class="campo-entrada campo-textarea @(ViewData.ModelState["Descricao"]?.Errors.Count > 0 ? "campo-invalido" : "")"></textarea>
            <span asp-validation-for="Descricao" class="campo-erro"></span>
        </div>
    </section>

    <section class="cartao secao-operacional">
        <h2>Identificação do vestígio</h2>

        <div class="grade-operacional">
            <div class="campo">
                <label asp-for="TipoVestigioId" class="campo-rotulo"></label>
                <select asp-for="TipoVestigioId" class="campo-entrada @(ViewData.ModelState["TipoVestigioId"]?.Errors.Count > 0 ? "campo-invalido" : "")">
                    <option value="">Selecione o tipo</option>
                    @foreach (var opcao in Model.TiposDisponiveis)
                    {
                        <option value="@opcao.Id">@opcao.Descricao</option>
                    }
                </select>
                <span asp-validation-for="TipoVestigioId" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="LocalColeta" class="campo-rotulo"></label>
                <input asp-for="LocalColeta" class="campo-entrada" />
                <span asp-validation-for="LocalColeta" class="campo-erro"></span>
            </div>
        </div>
    </section>

    <section class="cartao secao-operacional">
        <h2>Coleta</h2>

        <div class="grade-operacional">
            <div class="campo">
                <label asp-for="DataHoraColeta" class="campo-rotulo"></label>
                <input asp-for="DataHoraColeta" type="datetime-local" class="campo-entrada @(ViewData.ModelState["DataHoraColeta"]?.Errors.Count > 0 ? "campo-invalido" : "")" />
                <span asp-validation-for="DataHoraColeta" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="NumeroLacre" class="campo-rotulo"></label>
                <input asp-for="NumeroLacre" class="campo-entrada mono @(ViewData.ModelState["NumeroLacre"]?.Errors.Count > 0 ? "campo-invalido" : "")" />
                <span asp-validation-for="NumeroLacre" class="campo-erro"></span>
            </div>
        </div>

        <div class="campo">
            <label asp-for="MetodoColeta" class="campo-rotulo"></label>
            <textarea asp-for="MetodoColeta" rows="4" class="campo-entrada campo-textarea"></textarea>
            <span asp-validation-for="MetodoColeta" class="campo-erro"></span>
        </div>

        <div class="campo campo-checkbox">
            <label class="campo-checkbox-rotulo">
                <input asp-for="HouveIntercorrencia" type="checkbox" id="houve-intercorrencia" />
                Houve intercorrência na coleta?
            </label>
        </div>

        <div class="campo" id="bloco-intercorrencia" hidden>
            <label asp-for="DescricaoIntercorrencia" class="campo-rotulo"></label>
            <textarea asp-for="DescricaoIntercorrencia" rows="4" class="campo-entrada campo-textarea"></textarea>
            <span asp-validation-for="DescricaoIntercorrencia" class="campo-erro"></span>
        </div>

        <div class="campo">
            <label asp-for="ArquivoEvidencia" class="campo-rotulo"></label>
            <input asp-for="ArquivoEvidencia" type="file" class="campo-entrada" />
            <p class="campo-ajuda">Opcional. Se enviado, o hash e o CID serão incluídos na operação assinada.</p>
        </div>
    </section>

    <section class="cartao secao-operacional operacao-assinada" aria-labelledby="assinatura-title">
        <h2 id="assinatura-title">Assinatura da coleta</h2>
        <p class="campo-ajuda secao-formulario-intro">A coleta só será cadastrada após a confirmação da operação assinada no ledger.</p>
        <div class="grade-operacional">
            <div class="campo">
                <label for="senha-wallet" class="campo-rotulo">Senha da wallet</label>
                <input id="senha-wallet" name="SenhaWallet" type="password" autocomplete="current-password" class="campo-entrada" required />
            </div>
            <div class="campo">
                <label for="codigo-pareamento" class="campo-rotulo">Código de pareamento</label>
                <input id="codigo-pareamento" name="CodigoPareamento" type="password" autocomplete="one-time-code" class="campo-entrada" required />
            </div>
        </div>
        <p class="campo-ajuda estado-operacao" data-operacao-status role="status" aria-live="polite"></p>
        <p class="campo-erro" data-operacao-error role="alert" tabindex="-1" hidden></p>
    </section>

    <div class="acoes-formulario">
        <button type="submit" class="botao botao--primario">Assinar e registrar coleta</button>
    </div>
</form>


@section Scripts {
    <script>
        (function () {
            var check = document.getElementById('houve-intercorrencia');
            var bloco = document.getElementById('bloco-intercorrencia');
            function sincronizar() { bloco.hidden = !check.checked; }
            check.addEventListener('change', sincronizar);
            sincronizar();

            var form = document.getElementById('cadastro-vestigio-form');
            var walletUi = window.CustodyChainWallet;
            if (!form || !walletUi) return;
            var button = form.querySelector('button[type="submit"]');
            var password = document.getElementById('senha-wallet');
            var pairing = document.getElementById('codigo-pareamento');
            var status = form.querySelector('[data-operacao-status]');
            var error = form.querySelector('[data-operacao-error]');
            var antiForgery = form.querySelector('input[name="__RequestVerificationToken"]').value;

            function cadastro() {
                var value = function (name) { return form.querySelector('[name="' + name + '"]'); };
                return {
                    rotuloEvidencia: value('RotuloEvidencia').value,
                    rotuloConjunto: value('RotuloConjunto').value,
                    numeroEvidencia: value('NumeroEvidencia').value || null,
                    processoId: Number(value('ProcessoId').value) || null,
                    tipoVestigioId: Number(value('TipoVestigioId').value) || null,
                    descricao: value('Descricao').value,
                    localColeta: value('LocalColeta').value || null,
                    dataHoraColeta: value('DataHoraColeta').value,
                    metodoColeta: value('MetodoColeta').value || null,
                    numeroLacre: value('NumeroLacre').value,
                    houveIntercorrencia: check.checked,
                    descricaoIntercorrencia: value('DescricaoIntercorrencia').value || null
                };
            }

            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                walletUi.limparErro(error);
                if (!form.checkValidity()) { form.reportValidity(); return; }

                walletUi.definirProcessamento({ botao: button, painel: form, processando: true });
                try {
                    walletUi.definirStatus(status, 'Preparando a operação de coleta.', 'processando');
                    var command = await walletUi.requisicaoFormulario({
                        url: '/vestigios/cadastrar/comando', token: antiForgery, body: new FormData(form),
                        mensagemErro: 'Não foi possível preparar a coleta.'
                    });
                    walletUi.definirStatus(status, 'Aguardando assinatura na wallet.', 'aguardando');
                    var assinatura = await walletUi.requisicaoWallet({
                        endpoint: command.walletEndpoint, path: '/v1/proofs/signed-operation', pairingToken: pairing.value,
                        body: { did: command.signerDid, password: password.value, operation: command.operation },
                        mensagemErro: 'A wallet recusou a assinatura da coleta.'
                    });
                    walletUi.limparCamposSensíveis(password, pairing);
                    walletUi.definirStatus(status, 'Confirmando a coleta no ledger.', 'processando');
                    var result = await walletUi.requisicaoAplicacao({
                        url: '/vestigios/cadastrar/prova', token: antiForgery,
                        body: { cadastro: cadastro(), operation: assinatura.operation },
                        mensagemErro: 'Não foi possível registrar a coleta.'
                    });
                    window.location.assign(result.redirectUrl);
                } catch (exception) {
                    walletUi.limparCamposSensíveis(password, pairing);
                    walletUi.definirStatus(status, '', 'erro');
                    walletUi.exibirErro(error, exception.message);
                } finally {
                    walletUi.definirProcessamento({ botao: button, painel: form, processando: false });
                }
            });
        })();
    </script>
}
