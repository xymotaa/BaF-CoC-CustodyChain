@model CustodyChain.Web.Models.ViewModels.RecuperarIdentidadeViewModel
@{
    ViewData["Title"] = "Aprovar recuperação de chave DID";
}

<div class="pagina-cabecalho">
    <h1>Aprovar recuperação de chave DID</h1>
    <p class="campo-ajuda">Importe o pacote assinado pelo titular, revise a solicitação e assine a decisão administrativa.</p>
</div>

<section id="admin-recovery" class="cartao painel-operacao-wallet painel-recuperacao" data-wallet-endpoint="@Model.WalletEndpoint">
    @Html.AntiForgeryToken()
    <div id="recovery-error" class="alerta alerta-erro" role="alert" tabindex="-1" hidden></div>
    <div class="campo">
        <label class="campo-rotulo" for="package">Pacote de recuperação do titular</label>
        <textarea id="package" class="campo-entrada mono" rows="12" spellcheck="false" required></textarea>
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="reason">Motivo confirmado</label>
        <select id="reason" class="campo-entrada">
            <option value="LOST_KEY">Chave perdida</option>
            <option value="DEVICE_LOST">Dispositivo perdido</option>
            <option value="COMPROMISED">Chave comprometida</option>
        </select>
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="wallet-password">Senha da wallet administrativa</label>
        <input id="wallet-password" class="campo-entrada" type="password" autocomplete="current-password" required />
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="pairing-token">Código de pareamento</label>
        <input id="pairing-token" class="campo-entrada" type="password" autocomplete="off" required />
    </div>
    <button id="approve-recovery" class="botao botao--primario" type="button">Assinar e confirmar recuperação</button>
    <p id="recovery-status" role="status" aria-live="polite" class="campo-ajuda estado-operacao"></p>
</section>

@section Scripts {
    <script>
        (() => {
            const wallet = window.CustodyChainWallet;
            const panel = document.getElementById('admin-recovery');
            const button = document.getElementById('approve-recovery');
            const error = document.getElementById('recovery-error');
            const status = document.getElementById('recovery-status');
            const packageField = document.getElementById('package');
            const password = document.getElementById('wallet-password');
            const pairing = document.getElementById('pairing-token');
            const token = wallet.obterTokenAntiforgery(panel);
            const walletEndpoint = panel.dataset.walletEndpoint;
            button.addEventListener('click', async () => {
                wallet.limparErro(error);
                let recoveryPackage;
                try { recoveryPackage = JSON.parse(packageField.value); }
                catch {
                    wallet.exibirErro(error, 'O pacote de recuperação não contém JSON válido.');
                    return;
                }
                if (!recoveryPackage.request || !recoveryPackage.candidateSignature || !password.value || !pairing.value) {
                    wallet.exibirErro(error, 'Informe o pacote completo, a senha da wallet e o código de pareamento.');
                    return;
                }
                wallet.definirProcessamento({ botao: button, painel: panel, processando: true });
                try {
                    wallet.definirStatus(status, 'Montando a decisão administrativa.', 'processando');
                    const command = await wallet.requisicaoAplicacao({
                        url: '/gestao-perfis/recuperar-chave/comando', token,
                        body: { recoveryRequest: recoveryPackage.request, reason: document.getElementById('reason').value },
                        mensagemErro: 'Não foi possível confirmar a recuperação.'
                    });
                    wallet.definirStatus(status, 'Aguardando assinatura da decisão administrativa.', 'aguardando');
                    const proof = await wallet.requisicaoWallet({
                        endpoint: walletEndpoint, path: '/v1/proofs/did-key-recovery', pairingToken: pairing.value,
                        body: { did: command.actorDid, password: password.value, command },
                        mensagemErro: 'A wallet administrativa recusou a assinatura.'
                    });
                    password.value = '';
                    wallet.definirStatus(status, 'Confirmando as duas provas no ledger.', 'processando');
                    const result = await wallet.requisicaoAplicacao({
                        url: '/identidade/chave/recuperacao/prova', token,
                        body: { command, adminKeyId: proof.keyId, adminSignature: proof.signature, candidateSignature: recoveryPackage.candidateSignature },
                        mensagemErro: 'Não foi possível confirmar a recuperação.'
                    });
                    button.dataset.completed = 'true';
                    wallet.definirStatus(status, `Recuperação confirmada no ledger. Nova chave: ${result.keyId}.`, 'sucesso');
                } catch (exception) {
                    wallet.exibirErro(error, exception.message);
                    wallet.definirStatus(status, 'A recuperação não foi confirmada.', 'erro');
                } finally {
                    wallet.limparCamposSensíveis(password, pairing);
                    wallet.definirProcessamento({ botao: button, painel: panel, processando: false });
                    button.disabled = button.dataset.completed === 'true';
                }
            });
        })();
    </script>
}
