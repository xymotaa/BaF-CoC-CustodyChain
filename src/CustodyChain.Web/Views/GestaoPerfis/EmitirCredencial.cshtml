@model CustodyChain.Web.Models.ViewModels.EmitirCredencialPermissaoViewModel
@{
    ViewData["Title"] = "Emitir credencial de permissão";
}

<div class="pagina-cabecalho-acoes"><div><h1>Emitir credencial de permissão</h1><p class="campo-ajuda">Coletor recebe autorização por processo; Custódia recebe autorização por processo e vestígio. As operações são definidas pelo perfil.</p></div></div>

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagem</span>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>Verifique os campos destacados abaixo.</span>
    </div>
}

@if (Model.TitularesDisponiveis.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-identidade" /></svg></span>
        <p>Nenhum interveniente ativo disponível.</p>
    </div>
}
else
{
    <form id="credential-form" novalidate class="formulario-operacional">
        @Html.AntiForgeryToken()

        <section class="cartao secao-operacional">
            <div class="grade-operacional">
                <div class="campo">
                    <label asp-for="TitularId" class="campo-rotulo"></label>
                    <select asp-for="TitularId" class="campo-entrada @(ViewData.ModelState["TitularId"]?.Errors.Count > 0 ? "campo-invalido" : "")">
                        <option value="">Selecione o titular</option>
                        @foreach (var opcao in Model.TitularesDisponiveis)
                        {
                            <option value="@opcao.Id">@opcao.Nome — @opcao.PerfilNome</option>
                        }
                    </select>
                    <span asp-validation-for="TitularId" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="ProcessoId" class="campo-rotulo"></label>
                    <select asp-for="ProcessoId" class="campo-entrada">
                        <option value="">Selecione o processo</option>
                        @foreach (var opcao in Model.ProcessosDisponiveis)
                        {
                            <option value="@opcao.Id">@opcao.Numero</option>
                        }
                    </select>
                    <span asp-validation-for="ProcessoId" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="VestigioId" class="campo-rotulo"></label>
                    <select asp-for="VestigioId" class="campo-entrada">
                        <option value="">Sem vestígio (somente Coletor)</option>
                        @foreach (var opcao in Model.VestigiosDisponiveis)
                        {
                            <option value="@opcao.Id" data-processo-id="@opcao.ProcessoId">@opcao.RotuloEvidencia</option>
                        }
                    </select>
                    <span class="campo-ajuda">Para Custódia, selecione um vestígio do processo escolhido.</span>
                    <span asp-validation-for="VestigioId" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="ValidaAte" class="campo-rotulo"></label>
                    <input asp-for="ValidaAte" type="datetime-local" class="campo-entrada" />
                    <span class="campo-ajuda">Deixe em branco para validade indeterminada.</span>
                    <span asp-validation-for="ValidaAte" class="campo-erro"></span>
                </div>
                <div class="campo">
                    <label class="campo-rotulo" for="wallet-password">Senha da wallet emissora</label>
                    <input id="wallet-password" class="campo-entrada" type="password" autocomplete="current-password" required />
                    <span class="campo-ajuda">Usada somente pela wallet local para assinar a VC.</span>
                </div>
                <div class="campo">
                    <label class="campo-rotulo" for="pairing-token">Código de pareamento da wallet</label>
                    <input id="pairing-token" class="campo-entrada" type="password" autocomplete="off" required />
                </div>
            </div>
        </section>

        <div id="credential-error" class="alerta alerta-erro" role="alert" tabindex="-1" hidden></div>
        <p id="credential-status" role="status" aria-live="polite" class="campo-ajuda estado-operacao"></p>

        <div class="acoes-formulario">
            <button id="issue-credential" type="submit" class="botao botao--primario">Assinar e emitir VC</button>
        </div>
    </form>
}

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('credential-form');
            if (!form) return;

            const wallet = window.CustodyChainWallet;
            const button = document.getElementById('issue-credential');
            const password = document.getElementById('wallet-password');
            const pairing = document.getElementById('pairing-token');
            const processo = document.getElementById('ProcessoId');
            const vestigio = document.getElementById('VestigioId');
            const error = document.getElementById('credential-error');
            const status = document.getElementById('credential-status');
            const antiForgery = wallet.obterTokenAntiforgery(form);
            const postApplication = (url, body) => wallet.requisicaoAplicacao({
                url, token: antiForgery, body, mensagemErro: 'Não foi possível emitir a VC.'
            });
            const atualizarVestigios = () => {
                const processoId = processo.value;
                [...vestigio.options].forEach((option) => {
                    if (!option.dataset.processoId) return;
                    option.hidden = Boolean(processoId) && option.dataset.processoId !== processoId;
                });
                if (vestigio.selectedOptions[0]?.hidden) vestigio.value = '';
            };
            processo.addEventListener('change', atualizarVestigios);
            atualizarVestigios();
            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                wallet.limparErro(error);
                if (!wallet.camposPreenchidos(password, pairing)) {
                    wallet.exibirErro(error, 'Informe a senha e o código de pareamento da wallet.');
                    return;
                }
                wallet.definirProcessamento({ botao: button, painel: form, processando: true });
                try {
                    wallet.definirStatus(status, 'Preparando a VC de permissão.', 'processando');
                    const fields = new FormData(form);
                    const command = await postApplication('/gestao-perfis/emitir-credencial/comando', {
                        titularId: Number(fields.get('TitularId')) || null,
                        processoId: Number(fields.get('ProcessoId')) || null,
                        vestigioId: Number(fields.get('VestigioId')) || null,
                        validaAte: fields.get('ValidaAte') || null
                    });
                    wallet.definirStatus(status, 'Aguardando assinatura da wallet emissora.', 'aguardando');
                    const prova = await wallet.requisicaoWallet({ endpoint: command.walletEndpoint, path: '/v1/proofs/verifiable-credential', pairingToken: pairing.value, body: { did: command.issuerDid, password: password.value, credential: command.credential }, mensagemErro: 'A wallet recusou a assinatura da VC.' });
                    wallet.limparCamposSensíveis(password, pairing);
                    wallet.definirStatus(status, 'Registrando a VC assinada no ledger.', 'processando');
                    const result = await postApplication('/gestao-perfis/emitir-credencial/prova', {
                        emissaoId: command.emissaoId,
                        credential: prova.verifiableCredential
                    });
                    window.location.assign(result.redirectUrl);
                } catch (exception) {
                    wallet.limparCamposSensíveis(password, pairing);
                    wallet.definirStatus(status, '', 'erro');
                    wallet.exibirErro(error, exception.message);
                } finally {
                    wallet.definirProcessamento({ botao: button, painel: form, processando: false });
                }
            });
        })();
    </script>
}
