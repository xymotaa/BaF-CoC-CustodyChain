@model CustodyChain.Web.Models.ViewModels.AtivarDidV2ViewModel
@{
    ViewData["Title"] = "Ativar identidade DID";
}

<div class="pagina-cabecalho">
    <h1>Ativar @Model.Nome</h1>
    <p class="campo-ajuda">A ativação é autorizada pela assinatura da wallet administrativa; a senha não é enviada ao CustodyChain.</p>
</div>

<section class="cartao painel-ativacao">
    @Html.AntiForgeryToken()
    <dl>
        <dt>DID do titular</dt><dd class="mono">@Model.Did</dd>
        <dt>Administrador</dt><dd class="mono">@Model.DidAdministrador</dd>
    </dl>
    <div id="activation-error" class="alerta alerta-erro" role="alert" tabindex="-1" hidden></div>
    <div class="campo">
        <label class="campo-rotulo" for="wallet-password">Senha da wallet administrativa</label>
        <input id="wallet-password" class="campo-entrada" type="password" autocomplete="current-password" required />
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="pairing-token">Código de pareamento</label>
        <input id="pairing-token" class="campo-entrada" type="password" autocomplete="off" required />
    </div>
    <button id="activate" class="botao botao-primario" type="button">Assinar e ativar</button>
    <p id="activation-status" role="status" aria-live="polite" class="campo-ajuda"></p>
</section>

@section Scripts {
    <script>
        (() => {
            const button = document.getElementById('activate');
            const error = document.getElementById('activation-error');
            const status = document.getElementById('activation-status');
            const password = document.getElementById('wallet-password');
            const pairing = document.getElementById('pairing-token');
            const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const base = '/gestao-perfis/@Model.IntervenienteId/ativar';
            const applicationPost = async (url, body) => {
                const response = await fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgery }, body: JSON.stringify(body) });
                const payload = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(payload.message || 'Não foi possível ativar a identidade.');
                return payload;
            };
            button.addEventListener('click', async () => {
                error.hidden = true;
                if (!password.value || !pairing.value) { error.textContent = 'Informe a senha e o código de pareamento da wallet.'; error.hidden = false; return; }
                button.disabled = true;
                try {
                    status.textContent = 'Preparando autorização de ativação.';
                    const command = await applicationPost(`${base}/comando`, {});
                    status.textContent = 'Aguardando assinatura da wallet administrativa.';
                    const walletResponse = await fetch('@Model.WalletEndpoint/v1/proofs/did-activation', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Wallet-Pairing-Token': pairing.value }, body: JSON.stringify({ did: '@Model.DidAdministrador', password: password.value, command }) });
                    const proof = await walletResponse.json().catch(() => ({}));
                    if (!walletResponse.ok) throw new Error(proof.message || 'A wallet recusou a assinatura.');
                    password.value = '';
                    const result = await applicationPost(`${base}/prova`, { command, keyId: proof.keyId, signature: proof.signature });
                    window.location.assign(result.redirectUrl);
                } catch (exception) {
                    password.value = '';
                    error.textContent = exception.message;
                    error.hidden = false;
                    error.focus();
                } finally { button.disabled = false; }
            });
        })();
    </script>
}

@section Styles {
    <style>
        .pagina-cabecalho { margin-bottom: 1.5rem; }
        .painel-ativacao { max-width: 640px; padding: 1.5rem; }
        .painel-ativacao dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .65rem 1rem; margin: 0 0 1.5rem; }
        .painel-ativacao dt { color: var(--cor-texto-fraco); }.painel-ativacao dd { margin: 0; overflow-wrap: anywhere; }
        .painel-ativacao .campo { margin-bottom: 1rem; }.painel-ativacao .botao { min-height: 44px; }
    </style>
}
