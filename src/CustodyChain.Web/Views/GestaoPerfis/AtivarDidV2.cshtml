@model CustodyChain.Web.Models.ViewModels.AtivarDidV2ViewModel
@{
    ViewData["Title"] = "Ativar identidade DID";
}

<div class="pagina-cabecalho">
    <h1>Ativar @Model.Nome</h1>
    <p class="campo-ajuda">A ativação é autorizada pela assinatura da wallet administrativa; a senha não é enviada ao CustodyChain.</p>
</div>

<section id="activation-panel" class="cartao painel-operacao-wallet painel-ativacao" data-wallet-endpoint="@Model.WalletEndpoint">
    @Html.AntiForgeryToken()
    <dl class="resumo-identidade">
        <dt>DID do titular</dt><dd class="mono">@Model.Did</dd>
        <dt>Administrador</dt><dd class="mono">@Model.DidAdministrador</dd>
    </dl>
    <div id="activation-error" class="alerta alerta-erro" role="alert" tabindex="-1" hidden></div>
    <div class="campo">
        <label class="campo-rotulo" for="wallet-password">Senha da wallet administrativa</label>
        <input id="wallet-password" class="campo-entrada" type="password" autocomplete="current-password" required />
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="pairing-token">Código de pareamento</label>
        <input id="pairing-token" class="campo-entrada" type="password" autocomplete="off" required />
    </div>
    <button id="activate" class="botao botao-primario" type="button">Assinar e ativar</button>
    <p id="activation-status" role="status" aria-live="polite" class="campo-ajuda estado-operacao"></p>
</section>

@section Scripts {
    <script>
        (() => {
            const wallet = window.CustodyChainWallet;
            const panel = document.getElementById('activation-panel');
            const button = document.getElementById('activate');
            const error = document.getElementById('activation-error');
            const status = document.getElementById('activation-status');
            const password = document.getElementById('wallet-password');
            const pairing = document.getElementById('pairing-token');
            const antiForgery = wallet.obterTokenAntiforgery(panel);
            const base = '/gestao-perfis/@Model.IntervenienteId/ativar';
            button.addEventListener('click', async () => {
                wallet.limparErro(error);
                if (!wallet.camposPreenchidos(password, pairing)) {
                    wallet.exibirErro(error, 'Informe a senha e o código de pareamento da wallet.');
                    return;
                }
                wallet.definirProcessamento({ botao: button, painel: panel, processando: true });
                try {
                    wallet.definirStatus(status, 'Preparando autorização de ativação.', 'processando');
                    const command = await wallet.requisicaoAplicacao({
                        url: `${base}/comando`, token: antiForgery, body: {},
                        mensagemErro: 'Não foi possível ativar a identidade.'
                    });
                    wallet.definirStatus(status, 'Aguardando assinatura da wallet administrativa.', 'aguardando');
                    const proof = await wallet.requisicaoWallet({
                        endpoint: panel.dataset.walletEndpoint, path: '/v1/proofs/did-activation', pairingToken: pairing.value,
                        body: { did: '@Model.DidAdministrador', password: password.value, command },
                        mensagemErro: 'A wallet recusou a assinatura.'
                    });
                    password.value = '';
                    wallet.definirStatus(status, 'Confirmando a ativação no ledger.', 'processando');
                    const result = await wallet.requisicaoAplicacao({
                        url: `${base}/prova`, token: antiForgery, body: { command, keyId: proof.keyId, signature: proof.signature },
                        mensagemErro: 'Não foi possível ativar a identidade.'
                    });
                    wallet.definirStatus(status, 'Identidade ativada. Redirecionando…', 'sucesso');
                    window.location.assign(result.redirectUrl);
                } catch (exception) {
                    wallet.exibirErro(error, exception.message);
                    wallet.definirStatus(status, 'A ativação foi rejeitada ou não pôde ser concluída.', 'erro');
                } finally {
                    wallet.limparCamposSensíveis(password, pairing);
                    wallet.definirProcessamento({ botao: button, painel: panel, processando: false });
                }
            });
        })();
    </script>
}

@section Styles {
    <style>
        .pagina-cabecalho { margin-bottom: 1.5rem; }
        .painel-ativacao { max-width: 640px; }
        .painel-ativacao .campo { margin-bottom: 1rem; }
    </style>
}
