@model CustodyChain.Web.Models.ViewModels.RevogarCredencialViewModel
@{ ViewData["Title"] = "Revogar VC"; }
<div class="pagina-cabecalho-acao"><div><h1>Revogar VC de permissão</h1><p class="campo-ajuda">A revogação será assinada pela wallet emissora e registrada no Fabric.</p></div></div>
<section id="credential-revocation-panel" class="cartao painel-operacao-wallet" data-wallet-endpoint="@Model.WalletEndpoint">
    @Html.AntiForgeryToken()
    <dl class="resumo-identidade"><dt>Titular</dt><dd>@Model.TitularNome</dd><dt>Credencial</dt><dd class="mono codigo-forense">@Model.Identificador</dd><dt>Emissor</dt><dd class="mono codigo-forense">@Model.EmissorDid</dd></dl>
    <div id="revocation-error" class="alerta alerta-erro" role="alert" tabindex="-1" hidden></div>
    <div class="campo"><label class="campo-rotulo" for="wallet-password">Senha da wallet emissora</label><input id="wallet-password" class="campo-entrada" type="password" autocomplete="current-password" required /></div>
    <div class="campo"><label class="campo-rotulo" for="pairing-token">Código de pareamento da wallet</label><input id="pairing-token" class="campo-entrada" type="password" autocomplete="off" required /></div>
    <button id="revoke" class="botao botao-primario" type="button">Assinar e revogar VC</button>
    <p id="revocation-status" role="status" aria-live="polite" class="campo-ajuda estado-operacao"></p>
</section>
@section Scripts { <script>
(() => {
    const wallet = window.CustodyChainWallet;
    const panel = document.getElementById('credential-revocation-panel');
    const button = document.getElementById('revoke');
    const error = document.getElementById('revocation-error');
    const status = document.getElementById('revocation-status');
    const password = document.getElementById('wallet-password');
    const pairing = document.getElementById('pairing-token');
    const token = wallet.obterTokenAntiforgery(panel);
    const base = '/gestao-perfis/credenciais/@Model.Id/revogar';
    const post = (url, body) => wallet.requisicaoAplicacao({ url, token, body, mensagemErro: 'Não foi possível revogar a VC.' });
    button.addEventListener('click', async () => {
        wallet.limparErro(error);
        if (!wallet.camposPreenchidos(password, pairing)) { wallet.exibirErro(error, 'Informe a senha e o código de pareamento da wallet.'); return; }
        wallet.definirProcessamento({ botao: button, painel: panel, processando: true });
        try {
            wallet.definirStatus(status, 'Preparando a revogação.', 'processando');
            const command = await post(`${base}/comando`, {});
            wallet.definirStatus(status, 'Aguardando assinatura da wallet emissora.', 'aguardando');
            const proof = await wallet.requisicaoWallet({ endpoint: panel.dataset.walletEndpoint, path: '/v1/proofs/credential-revocation', pairingToken: pairing.value, body: { did: '@Model.EmissorDid', password: password.value, command }, mensagemErro: 'A wallet recusou a revogação.' });
            wallet.limparCamposSensíveis(password, pairing);
            wallet.definirStatus(status, 'Registrando revogação no ledger.', 'processando');
            const result = await post(`${base}/prova`, { command, keyId: proof.keyId, signature: proof.signature });
            wallet.definirStatus(status, 'Revogação confirmada. Redirecionando…', 'sucesso');
            window.location.assign(result.redirectUrl);
        } catch (exception) {
            wallet.limparCamposSensíveis(password, pairing);
            wallet.definirStatus(status, '', 'erro');
            wallet.exibirErro(error, exception.message);
        } finally { wallet.definirProcessamento({ botao: button, painel: panel, processando: false }); }
    });
})();
</script> }
