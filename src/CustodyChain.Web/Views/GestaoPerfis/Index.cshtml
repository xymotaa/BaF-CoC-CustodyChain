@model CustodyChain.Web.Models.ViewModels.GestaoPerfisListaViewModel
@{
    ViewData["Title"] = "Gestão de perfis";
}

<div class="pagina-cabecalho-acoes pagina-cabecalho-registros">
    <div>
        <h1>Gestão de perfis</h1>
        <p class="campo-ajuda">A identidade no ledger é verificada separadamente da situação cadastral.</p>
    </div>
    <div class="navegacao-operacional">
        <a href="/gestao-perfis/cadastrar" class="botao botao--primario botao--compacto">Novo interveniente</a>
        <a href="/gestao-perfis/emitir-credencial" class="botao botao--secundario botao--compacto">Emitir credencial</a>
        <a href="/gestao-perfis/credenciais" class="botao botao--terciario botao--compacto">Credenciais</a>
        <a href="/gestao-perfis/recuperar-chave" class="botao botao--terciario botao--compacto">Recuperações</a>
    </div>
</div>

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagemSucesso</span>
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>@mensagemErro</span>
    </div>
}

@if (Model.Intervenientes.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-perfis" /></svg></span>
        <p>Nenhum interveniente cadastrado.</p>
    </div>
}
else
{
    <section class="cartao painel-listagem-registros painel-listagem-perfis">
        <header class="painel-listagem-cabecalho">
            <div>
                <p class="painel-listagem-rotulo">Base de identidades</p>
                <h2>Intervenientes cadastrados</h2>
            </div>
            <p class="contador-registros" aria-label="Quantidade de intervenientes">@Model.Intervenientes.Count registro(s)</p>
        </header>
        <div class="painel-listagem-contexto">
            <span>Consulte situação cadastral, DID, perfil e estado da identidade no ledger.</span>
        </div>
        <div class="tabela-operacional-wrapper tabela-registros-wrapper">
        <table class="tabela-operacional tabela-registros tabela-perfis">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Perfil</th>
                    <th>DID</th>
                    <th>Situação</th>
                    <th>Identidade no ledger</th>
                    <th>Ativado em</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Intervenientes)
                {
                    var classeSituacao = item.Situacao switch
                    {
                        "ATIVO" => "selo--ativo",
                        "GERADO" => "selo--pendente",
                        "REVOGACAO_PENDENTE" => "selo--pendente",
                        "REVOGADO" => "selo--revogado",
                        _ => ""
                    };
                    var classeLedger = item.SituacaoIdentidadeLedger switch
                    {
                        "ATIVA" => "selo--ativo",
                        "PENDENTE_ATIVACAO" => "selo--pendente",
                        "INATIVA" or "AUSENTE_NO_LEDGER" => "selo--ausente",
                        _ => ""
                    };
                    <tr>
                        <td data-rotulo="Nome">@item.Nome</td>
                        <td data-rotulo="Perfil">@item.PerfilNome</td>
                        <td data-rotulo="DID"><span class="mono codigo-forense">@item.Did</span></td>
                        <td data-rotulo="Situação"><span class="selo @classeSituacao">@item.Situacao</span></td>
                        <td data-rotulo="Identidade no ledger"><span class="selo @classeLedger">@item.SituacaoIdentidadeLedger</span></td>
                        <td data-rotulo="Ativado em">@(item.AtivadoEm?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td data-rotulo="Ações"><div class="acoes-administrativas">
                            @if (item.Situacao == "GERADO")
                            {
                                <a class="botao botao--primario" href="/gestao-perfis/@item.Id/ativar">Ativar com prova</a>
                            }
                            else if (item.Situacao == "ATIVO")
                            {
                                <form action="/gestao-perfis/@item.Id/sincronizar-identidade" method="post" class="formulario-acao-tabela">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="botao botao--secundario">Sincronizar identidade</button>
                                </form>
                                @if (item.SituacaoIdentidadeLedger == "AUSENTE_NO_LEDGER")
                                {
                                    <form action="/gestao-perfis/@item.Id/reinscrever" method="post" class="formulario-acao-tabela">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="botao botao--primario">Reinscrever DID</button>
                                    </form>
                                }
                            <a class="botao botao--secundario" href="/gestao-perfis/@item.Id/revogar">Revogar com prova</a>
                            }
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </section>
}
