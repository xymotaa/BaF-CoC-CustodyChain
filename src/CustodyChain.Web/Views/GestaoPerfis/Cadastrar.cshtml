@model CustodyChain.Web.Models.ViewModels.CadastrarIntervenienteViewModel
@{
    ViewData["Title"] = "Cadastrar interveniente";
}

<div class="pagina-cabecalho-acoes"><div><h1>Cadastrar interveniente</h1><p class="campo-ajuda">Reserva a identidade do interveniente e cria uma inscrição para que ele gere a própria chave na wallet.</p></div></div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>Verifique os campos destacados abaixo.</span>
    </div>
}

<form asp-controller="GestaoPerfis" asp-action="Cadastrar" method="post" novalidate class="formulario-operacional">
    @Html.AntiForgeryToken()

    <section class="cartao secao-operacional">
        <div class="grade-operacional">
            <div class="campo">
                <label asp-for="Nome" class="campo-rotulo"></label>
                <input asp-for="Nome" class="campo-entrada @(ViewData.ModelState["Nome"]?.Errors.Count > 0 ? "campo-invalido" : "")" />
                <span asp-validation-for="Nome" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="PerfilId" class="campo-rotulo"></label>
                <select asp-for="PerfilId" class="campo-entrada @(ViewData.ModelState["PerfilId"]?.Errors.Count > 0 ? "campo-invalido" : "")">
                    <option value="">Selecione o perfil</option>
                    @foreach (var opcao in Model.PerfisDisponiveis)
                    {
                        <option value="@opcao.Id">@opcao.Nome</option>
                    }
                </select>
                <span asp-validation-for="PerfilId" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="Matricula" class="campo-rotulo"></label>
                <input asp-for="Matricula" class="campo-entrada mono" />
                <span asp-validation-for="Matricula" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="Orgao" class="campo-rotulo"></label>
                <input asp-for="Orgao" class="campo-entrada" />
                <span asp-validation-for="Orgao" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="Lotacao" class="campo-rotulo"></label>
                <input asp-for="Lotacao" class="campo-entrada" />
                <span asp-validation-for="Lotacao" class="campo-erro"></span>
            </div>
        </div>
    </section>

    <div class="acoes-formulario">
        <button type="submit" class="botao botao--primario">Cadastrar e criar inscrição</button>
    </div>
</form>
