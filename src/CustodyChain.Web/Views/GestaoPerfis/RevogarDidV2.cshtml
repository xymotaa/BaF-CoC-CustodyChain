@model CustodyChain.Web.Models.ViewModels.RevogarDidV2ViewModel
@{
    ViewData["Title"] = "Revogar identidade DID";
}

<div class="pagina-cabecalho">
    <h1>Revogar @Model.Nome</h1>
    <p class="campo-ajuda">A revogação é permanente para esta identidade. O ledger registra o ato assinado e preserva o histórico de custódia.</p>
</div>

<section class="cartao painel-revogacao">
    @Html.AntiForgeryToken()
    <dl>
        <dt>DID a revogar</dt><dd class="mono">@Model.Did</dd>
        <dt>Administrador signatário</dt><dd class="mono">@Model.DidAdministrador</dd>
    </dl>
    <div id="revocation-error" class="alerta alerta-erro" role="alert" tabindex="-1" hidden></div>
    <div class="campo">
        <label><input id="confirm-revocation" type="checkbox" /> Confirmo a revogação desta identidade.</label>
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="wallet-password">Senha da wallet administrativa</label>
        <input id="wallet-password" class="campo-entrada" type="password" autocomplete="current-password" required />
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="pairing-token">Código de pareamento</label>
        <input id="pairing-token" class="campo-entrada" type="password" autocomplete="off" required />
    </div>
    <button id="revoke" class="botao botao-primario" type="button">Assinar e revogar</button>
    <p id="revocation-status" role="status" aria-live="polite" class="campo-ajuda"></p>
</section>

@section Scripts {
<script>
(() => {
    const button = document.getElementById('revoke'), error = document.getElementById('revocation-error');
    const status = document.getElementById('revocation-status'), password = document.getElementById('wallet-password');
    const pairing = document.getElementById('pairing-token'), confirmation = document.getElementById('confirm-revocation');
    const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const base = '/gestao-perfis/@Model.IntervenienteId/revogar';
    const post = async (url, body) => {
        const response = await fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgery }, body: JSON.stringify(body) });
        const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.message || 'Não foi possível revogar a identidade.');
            return payload;
    };
    button.addEventListener('click', async () => {
        error.hidden = true;
        if (!confirmation.checked || !password.value || !pairing.value) {
            error.textContent = 'Confirme a revogação e informe a senha e o código de pareamento da wallet.';
            error.hidden = false; error.focus(); return;
        }
        button.disabled = true;
        try {
            status.textContent = 'Preparando a revogação.';
            const command = await post(`${base}/comando`, {});
            status.textContent = 'Aguardando assinatura da wallet administrativa.';
            const response = await fetch('@Model.WalletEndpoint/v1/proofs/did-revocation', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Wallet-Pairing-Token': pairing.value }, body: JSON.stringify({ did: '@Model.DidAdministrador', password: password.value, command }) });
            const proof = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(proof.message || 'A wallet recusou a assinatura.');
            password.value = '';
            const result = await post(`${base}/prova`, { command, keyId: proof.keyId, signature: proof.signature });
            if (!result.redirectUrl) {
                status.textContent = result.message || 'A revogação está em processamento.';
                button.dataset.processing = 'true';
                return;
            }
            window.location.assign(result.redirectUrl);
        } catch (exception) {
            password.value = ''; error.textContent = exception.message; error.hidden = false; error.focus();
        } finally { button.disabled = button.dataset.processing === 'true'; }
    });
})();
</script>
}

@section Styles {
<style>
    .pagina-cabecalho { margin-bottom: 1.5rem; }
    .painel-revogacao { max-width: 640px; padding: 1.5rem; }
    .painel-revogacao dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .65rem 1rem; margin: 0 0 1.5rem; }
    .painel-revogacao dt { color: var(--cor-texto-fraco); }.painel-revogacao dd { margin: 0; overflow-wrap: anywhere; }
    .painel-revogacao .campo { margin-bottom: 1rem; }.painel-revogacao .botao { min-height: 44px; }
</style>
}
