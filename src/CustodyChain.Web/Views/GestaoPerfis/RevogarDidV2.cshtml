@model CustodyChain.Web.Models.ViewModels.RevogarDidV2ViewModel
@{
    ViewData["Title"] = "Revogar identidade DID";
}

<div class="pagina-cabecalho">
    <h1>Revogar @Model.Nome</h1>
    <p class="campo-ajuda">A revogação é permanente para esta identidade. O ledger registra o ato assinado e preserva o histórico de custódia.</p>
</div>

<section id="revocation-panel" class="cartao painel-operacao-wallet painel-revogacao" data-wallet-endpoint="@Model.WalletEndpoint">
    @Html.AntiForgeryToken()
    <dl class="resumo-identidade">
        <dt>DID a revogar</dt><dd class="mono">@Model.Did</dd>
        <dt>Administrador signatário</dt><dd class="mono">@Model.DidAdministrador</dd>
    </dl>
    <div id="revocation-error" class="alerta alerta-erro" role="alert" tabindex="-1" hidden></div>
    <div class="campo">
        <label><input id="confirm-revocation" type="checkbox" /> Confirmo a revogação desta identidade.</label>
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="wallet-password">Senha da wallet administrativa</label>
        <input id="wallet-password" class="campo-entrada" type="password" autocomplete="current-password" required />
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="pairing-token">Código de pareamento</label>
        <input id="pairing-token" class="campo-entrada" type="password" autocomplete="off" required />
    </div>
    <button id="revoke" class="botao botao-primario" type="button">Assinar e revogar</button>
    <p id="revocation-status" role="status" aria-live="polite" class="campo-ajuda estado-operacao"></p>
</section>

@section Scripts {
<script>
(() => {
    const wallet = window.CustodyChainWallet;
    const panel = document.getElementById('revocation-panel');
    const button = document.getElementById('revoke'), error = document.getElementById('revocation-error');
    const status = document.getElementById('revocation-status'), password = document.getElementById('wallet-password');
    const pairing = document.getElementById('pairing-token'), confirmation = document.getElementById('confirm-revocation');
    const antiForgery = wallet.obterTokenAntiforgery(panel);
    const base = '/gestao-perfis/@Model.IntervenienteId/revogar';
    button.addEventListener('click', async () => {
        wallet.limparErro(error);
        if (!confirmation.checked || !password.value || !pairing.value) {
            wallet.exibirErro(error, 'Confirme a revogação e informe a senha e o código de pareamento da wallet.');
            return;
        }
        wallet.definirProcessamento({ botao: button, painel: panel, processando: true });
        try {
            wallet.definirStatus(status, 'Preparando a revogação.', 'processando');
            const command = await wallet.requisicaoAplicacao({
                url: `${base}/comando`, token: antiForgery, body: {},
                mensagemErro: 'Não foi possível revogar a identidade.'
            });
            wallet.definirStatus(status, 'Aguardando assinatura da wallet administrativa.', 'aguardando');
            const proof = await wallet.requisicaoWallet({
                endpoint: panel.dataset.walletEndpoint, path: '/v1/proofs/did-revocation', pairingToken: pairing.value,
                body: { did: '@Model.DidAdministrador', password: password.value, command },
                mensagemErro: 'A wallet recusou a assinatura.'
            });
            password.value = '';
            wallet.definirStatus(status, 'Confirmando a revogação no ledger.', 'processando');
            const result = await wallet.requisicaoAplicacao({
                url: `${base}/prova`, token: antiForgery, body: { command, keyId: proof.keyId, signature: proof.signature },
                mensagemErro: 'Não foi possível revogar a identidade.'
            });
            if (!result.redirectUrl) {
                wallet.definirStatus(status, result.message || 'A revogação está em processamento e será reconciliada.', 'pendente');
                button.dataset.processing = 'true';
                return;
            }
            wallet.definirStatus(status, 'Revogação confirmada. Redirecionando…', 'sucesso');
            window.location.assign(result.redirectUrl);
        } catch (exception) {
            wallet.exibirErro(error, exception.message);
            wallet.definirStatus(status, 'A revogação foi rejeitada ou não pôde ser concluída.', 'erro');
        } finally {
            wallet.limparCamposSensíveis(password, pairing);
            wallet.definirProcessamento({ botao: button, painel: panel, processando: false });
            button.disabled = button.dataset.processing === 'true';
        }
    });
})();
</script>
}

@section Styles {
<style>
    .pagina-cabecalho { margin-bottom: 1.5rem; }
    .painel-revogacao { max-width: 640px; }
    .painel-revogacao .campo { margin-bottom: 1rem; }
</style>
}
