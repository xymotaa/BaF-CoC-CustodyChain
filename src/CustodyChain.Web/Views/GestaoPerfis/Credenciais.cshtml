@model CustodyChain.Web.Models.ViewModels.GestaoCredenciaisViewModel
@{ ViewData["Title"] = "Credenciais de permissão"; }
<div class="pagina-cabecalho pagina-cabecalho-acao"><div><h1>Credenciais de permissão</h1><p class="campo-ajuda">A validade é consultada no Fabric; a revogação requer a assinatura da wallet emissora.</p></div><a href="/gestao-perfis/emitir-credencial" class="botao botao-secundario">Emitir credencial</a></div>
@if (Model.Credenciais.Count == 0) { <div class="painel-vazio"><p>Nenhuma credencial de permissão emitida.</p></div> } else { <div class="tabela-wrapper"><table class="tabela-arquivo"><thead><tr><th>Titular</th><th>Identificador</th><th>Situação</th><th>Validade</th><th>Ação</th></tr></thead><tbody>@foreach (var item in Model.Credenciais) { <tr><td>@item.TitularNome</td><td><span class="mono">@item.Identificador</span></td><td><span class="selo">@item.Situacao</span></td><td>@(item.ValidaAte?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Indeterminada")</td><td>@if (item.Situacao == "VIGENTE") { <a class="botao botao-secundario" href="/gestao-perfis/credenciais/@item.Id/revogar">Revogar com prova</a> }</td></tr>}</tbody></table></div>}
@section Styles { <style>.pagina-cabecalho{margin-bottom:1.5rem}.pagina-cabecalho-acao{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}.tabela-wrapper{overflow-x:auto;border:1px solid var(--cor-borda);border-radius:var(--raio);background:var(--cor-superficie)}.tabela-arquivo{width:100%;border-collapse:collapse;font-size:.875rem}.tabela-arquivo th,.tabela-arquivo td{text-align:left;padding:.75rem 1rem;border-bottom:1px solid var(--cor-borda);vertical-align:middle}.tabela-arquivo th{color:var(--cor-texto-fraco);white-space:nowrap}.painel-vazio{border:1px dashed var(--cor-borda-forte);border-radius:var(--raio);padding:2rem;color:var(--cor-texto-suave)}</style> }
