@model CustodyChain.Web.Models.ViewModels.ArquivoListaViewModel
@{
    ViewData["Title"] = "Arquivo";
}

<div class="pagina-cabecalho pagina-cabecalho-acao">
    <div>
        <h1>Arquivo</h1>
    </div>
    <a href="/arquivo/entrada" class="botao botao-secundario">Registrar entrada</a>
</div>

<form asp-controller="Arquivo" asp-action="Index" method="get" class="formulario-busca">
    <div class="campo campo-busca">
        <label for="busca" class="campo-rotulo sr-only">Buscar</label>
        <input type="search" id="busca" name="busca" value="@Model.Busca" class="campo-entrada" placeholder="Rótulo, hash, processo ou responsável" />
    </div>
    <div class="campo campo-filtro">
        <label for="categoria" class="campo-rotulo sr-only">Categoria</label>
        <select id="categoria" name="categoria" class="campo-entrada">
            <option value="">Todas as categorias</option>
            @foreach (var cat in Model.Categorias)
            {
                <option value="@cat" selected="@(cat == Model.CategoriaFiltro)">@cat</option>
            }
        </select>
    </div>
    <button type="submit" class="botao botao-secundario">Buscar</button>
</form>

@if (Model.Itens.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-arquivo" /></svg></span>
        <p>Nenhum vestígio encontrado.</p>
    </div>
}
else
{
    <div class="tabela-wrapper">
        <table class="tabela-arquivo">
            <thead>
                <tr>
                    <th>Rótulo</th>
                    <th>Tipo</th>
                    <th>Processo</th>
                    <th>Estado</th>
                    <th>Custódia atual</th>
                    <th>Hash</th>
                    <th>Guarda</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Itens)
                {
                    <tr>
                        <td>
                            <span class="mono">@item.RotuloEvidencia</span>
                            <div class="tabela-descricao">@item.Descricao</div>
                        </td>
                        <td>@item.TipoVestigio</td>
                        <td class="mono">@item.ProcessoNumero</td>
                        <td><span class="selo">@item.Estado</span></td>
                        <td>@(item.CustodianteNome ?? "—")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.HashSha256))
                            {
                                <span class="mono tabela-hash" title="@item.HashSha256">@item.HashSha256[..12]…</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            @if (item.PrazoGuardaAte is not null)
                            {
                                <span class="@(item.PrazoVencido ? "tabela-prazo-vencido" : "")">
                                    @item.PrazoGuardaAte.Value.ToString("dd/MM/yyyy")
                                    @if (item.PrazoVencido)
                                    {
                                        <span class="selo selo-alerta">Vencido</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Styles {
    <style>
        .pagina-cabecalho { margin-bottom: 1.5rem; }
        .pagina-cabecalho h1 { margin-bottom: 0.25rem; }

        .pagina-cabecalho-acao {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .formulario-busca {
            display: flex;
            gap: 0.75rem;
            align-items: flex-end;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .campo-busca { flex: 1 1 280px; margin-bottom: 0; }
        .campo-filtro { flex: 0 1 200px; margin-bottom: 0; }

        .painel-vazio {
            border: 1px dashed var(--cor-borda-forte);
            border-radius: var(--raio);
            padding: 2rem 1.5rem;
            text-align: center;
            color: var(--cor-texto-suave);
        }

        .painel-vazio-icone {
            display: inline-flex;
            color: var(--cor-texto-fraco);
            margin-bottom: 0.5rem;
        }

        .tabela-wrapper {
            overflow-x: auto;
            border: 1px solid var(--cor-borda);
            border-radius: var(--raio);
            background: var(--cor-superficie);
        }

        .tabela-arquivo {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        .tabela-arquivo th {
            text-align: left;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            color: var(--cor-texto-fraco);
            font-weight: 600;
            border-bottom: 1px solid var(--cor-borda);
            white-space: nowrap;
        }

        .tabela-arquivo td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--cor-borda);
            vertical-align: top;
        }

        .tabela-arquivo tbody tr:last-child td {
            border-bottom: none;
        }

        .tabela-descricao {
            color: var(--cor-texto-fraco);
            font-size: 0.8125rem;
            margin-top: 0.125rem;
        }

        .tabela-hash {
            cursor: help;
        }

        .tabela-prazo-vencido {
            color: var(--cor-erro);
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
        }

        .selo-alerta {
            background: var(--cor-erro-fundo);
            color: var(--cor-erro);
        }
    </style>
}
