@model CustodyChain.Web.Models.ViewModels.DarEntradaArquivoViewModel
@{
    ViewData["Title"] = "Entrada no arquivo";
}

<div class="pagina-cabecalho pagina-cabecalho-acoes">
    <div>
        <h1>Entrada no arquivo</h1>
        <p class="campo-ajuda">Registra a guarda de um vestígio recebido, com prazo de guarda (art. 158-E).</p>
    </div>
    <nav class="navegacao-operacional" aria-label="Navegação da cadeia de custódia">
        <a class="botao botao--secundario" href="/arquivo">Consultar arquivo</a>
        <a class="botao botao--secundario" href="/auditoria">Consultar histórico</a>
    </nav>
</div>

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagem</span>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>Verifique os campos destacados abaixo.</span>
    </div>
}

@if (Model.VestigiosDisponiveis.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-arquivo" /></svg></span>
        <p>Nenhum vestígio recebido aguardando arquivamento.</p>
    </div>
}
else
{
    <form id="entrada-arquivo-form" method="post" novalidate class="formulario-operacional">
        @Html.AntiForgeryToken()

        <section class="cartao secao-operacional">
            <div class="grade-operacional">
                <div class="campo">
                    <label asp-for="VestigioId" class="campo-rotulo"></label>
                    <select asp-for="VestigioId" class="campo-entrada @(ViewData.ModelState["VestigioId"]?.Errors.Count > 0 ? "campo-invalido" : "")">
                        <option value="">Selecione o vestígio</option>
                        @foreach (var opcao in Model.VestigiosDisponiveis)
                        {
                            <option value="@opcao.Id">@opcao.RotuloEvidencia — @opcao.Descricao</option>
                        }
                    </select>
                    <span asp-validation-for="VestigioId" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="Central" class="campo-rotulo"></label>
                    <input asp-for="Central" class="campo-entrada @(ViewData.ModelState["Central"]?.Errors.Count > 0 ? "campo-invalido" : "")" />
                    <span asp-validation-for="Central" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="Posicao" class="campo-rotulo"></label>
                    <input asp-for="Posicao" class="campo-entrada mono" />
                    <span asp-validation-for="Posicao" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="PrazoGuardaAte" class="campo-rotulo"></label>
                    <input asp-for="PrazoGuardaAte" type="date" class="campo-entrada" />
                    <span asp-validation-for="PrazoGuardaAte" class="campo-erro"></span>
                </div>
            </div>
        </section>

        <section class="cartao secao-operacional operacao-assinada" aria-labelledby="assinatura-guarda-title">
            <h2 id="assinatura-guarda-title">Assinatura da guarda</h2>
            <p class="campo-ajuda">A wallet do custodiante confirma o registro antes do armazenamento no ledger.</p>
            <div class="grade-operacional">
                <div class="campo">
                    <label for="senha-wallet" class="campo-rotulo">Senha da wallet</label>
                    <input id="senha-wallet" name="SenhaWallet" type="password" autocomplete="current-password" class="campo-entrada" required />
                </div>
                <div class="campo">
                    <label for="codigo-pareamento" class="campo-rotulo">Código de pareamento</label>
                    <input id="codigo-pareamento" name="CodigoPareamento" type="password" autocomplete="one-time-code" class="campo-entrada" required />
                </div>
            </div>
            <p class="campo-ajuda estado-operacao" data-operacao-status role="status" aria-live="polite"></p>
            <p class="campo-erro" data-operacao-error role="alert" tabindex="-1" hidden></p>
        </section>

        <div class="acoes-formulario">
            <button type="submit" class="botao botao--primario">Assinar e arquivar</button>
        </div>
    </form>
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('entrada-arquivo-form');
            if (!form) return;
            var walletUi = window.CustodyChainWallet;
            if (!walletUi) return;
            var button = form.querySelector('button[type="submit"]');
            var password = document.getElementById('senha-wallet');
            var pairing = document.getElementById('codigo-pareamento');
            var status = form.querySelector('[data-operacao-status]');
            var error = form.querySelector('[data-operacao-error]');
            var antiForgery = form.querySelector('input[name="__RequestVerificationToken"]').value;

            function payload() {
                var field = function (name) { return form.querySelector('[name="' + name + '"]'); };
                return {
                    vestigioId: Number(field('VestigioId').value) || null,
                    central: field('Central').value,
                    posicao: field('Posicao').value || null,
                    prazoGuardaAte: field('PrazoGuardaAte').value || null
                };
            }

            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                walletUi.limparErro(error);
                if (!form.checkValidity()) { form.reportValidity(); return; }

                walletUi.definirProcessamento({ botao: button, painel: form, processando: true });
                try {
                    var dados = payload();
                    walletUi.definirStatus(status, 'Preparando a guarda.', 'processando');
                    var command = await walletUi.requisicaoAplicacao({
                        url: '/arquivo/entrada/comando', token: antiForgery, body: dados,
                        mensagemErro: 'Não foi possível preparar a guarda.'
                    });
                    walletUi.definirStatus(status, 'Aguardando assinatura na wallet.', 'aguardando');
                    var assinatura = await walletUi.requisicaoWallet({
                        endpoint: command.walletEndpoint, path: '/v1/proofs/signed-operation', pairingToken: pairing.value,
                        body: { did: command.signerDid, password: password.value, operation: command.operation },
                        mensagemErro: 'A wallet recusou a assinatura.'
                    });
                    walletUi.limparCamposSensíveis(password, pairing);
                    walletUi.definirStatus(status, 'Confirmando a guarda no ledger.', 'processando');
                    var result = await walletUi.requisicaoAplicacao({
                        url: '/arquivo/entrada/prova', token: antiForgery,
                        body: { entrada: dados, operation: assinatura.operation },
                        mensagemErro: 'Não foi possível registrar a guarda.'
                    });
                    window.location.assign(result.redirectUrl);
                } catch (exception) {
                    walletUi.limparCamposSensíveis(password, pairing);
                    walletUi.definirStatus(status, '', 'erro');
                    walletUi.exibirErro(error, exception.message);
                } finally {
                    walletUi.definirProcessamento({ botao: button, painel: form, processando: false });
                }
            });
        })();
    </script>
}
