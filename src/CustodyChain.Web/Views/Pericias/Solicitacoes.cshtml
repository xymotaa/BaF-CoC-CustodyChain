@model CustodyChain.Web.Models.ViewModels.SolicitacoesDesignacaoPericiaViewModel
@{
    ViewData["Title"] = "Solicitações de perícia";
}

<div class="pagina-cabecalho-acoes"><div><h1>Solicitações de perícia</h1><p class="campo-ajuda">Revise o escopo antes de assinar a credencial que autoriza o perito.</p></div></div>

@if (TempData["MensagemSucesso"] is string sucesso)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@sucesso</span>
    </div>
}
@if (TempData["MensagemErro"] is string erro)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>@erro</span>
    </div>
}

@if (Model.Solicitacoes.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-pericia" /></svg></span>
        <p>Não há solicitações aguardando aprovação.</p>
    </div>
}
else
{
    <div class="lista-operacional">
        @foreach (var item in Model.Solicitacoes)
        {
            <article class="cartao item-operacional solicitacao">
                <div>
                    <h2>@item.RotuloEvidencia</h2>
                    <dl class="solicitacao-dados">
                        <div><dt>Perito</dt><dd>@item.PeritoNome</dd></div>
                        <div><dt>Área</dt><dd>@(item.AreaPericial ?? "Não informada")</dd></div>
                        <div><dt>Prioridade</dt><dd>@item.Prioridade</dd></div>
                        <div><dt>Solicitada em</dt><dd>@item.SolicitadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                    </dl>
                </div>
                <a class="botao botao--primario" href="/pericias/@item.PericiaId/aprovar">Revisar e assinar</a>
            </article>
        }
    </div>
}
