@model CustodyChain.Web.Models.ViewModels.RecebimentoListaViewModel
@{
    ViewData["Title"] = "Recebimento";
}

<div class="pagina-cabecalho">
    <h1>Recebimento</h1>
    <p class="campo-ajuda">Itens em trânsito destinados a você. Confira o lacre antes de confirmar.</p>
</div>

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagemSucesso</span>
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>@mensagemErro</span>
    </div>
}

@if (Model.Pendentes.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-recebimento" /></svg></span>
        <p>Nenhum item em trânsito para você no momento.</p>
    </div>
}
else
{
    <div class="lista-recebimento">
        @foreach (var item in Model.Pendentes)
        {
            <section class="cartao item-recebimento">
                <div class="item-recebimento-cabecalho">
                    <div>
                        <span class="mono item-recebimento-rotulo">@item.RotuloEvidencia</span>
                        <p class="item-recebimento-descricao">@item.Descricao</p>
                    </div>
                    <span class="selo">Em trânsito</span>
                </div>

                <dl class="item-recebimento-detalhes">
                    <div>
                        <dt>Origem</dt>
                        <dd>@item.OrigemNome</dd>
                    </div>
                    <div>
                        <dt>Saída</dt>
                        <dd>@(item.DataHoraSaida?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Rastreamento</dt>
                        <dd class="mono">@(item.CodigoRastreamento ?? "—")</dd>
                    </div>
                </dl>

                <div class="item-recebimento-acoes">
                    <form method="post" class="formulario-inline" data-recebimento-operacao="confirmar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MovimentacaoId" value="@item.MovimentacaoId" />
                        <div class="campo campo-inline">
                            <label class="campo-rotulo">Número do lacre conferido</label>
                            <input name="NumeroLacreConferido" class="campo-entrada mono" required />
                        </div>
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="senha-wallet-confirmar-@item.MovimentacaoId">Senha da wallet</label>
                            <input id="senha-wallet-confirmar-@item.MovimentacaoId" name="SenhaWallet" type="password" autocomplete="current-password" class="campo-entrada" required />
                        </div>
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="pareamento-confirmar-@item.MovimentacaoId">Código de pareamento</label>
                            <input id="pareamento-confirmar-@item.MovimentacaoId" name="CodigoPareamento" type="password" autocomplete="one-time-code" class="campo-entrada" required />
                        </div>
                        <p class="campo-ajuda" data-operacao-status role="status" aria-live="polite"></p>
                        <p class="campo-erro" data-operacao-error role="alert" tabindex="-1" hidden></p>
                        <button type="submit" class="botao botao-primario">Assinar e confirmar recebimento</button>
                    </form>

                    <form method="post" class="formulario-inline" data-recebimento-operacao="recusar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MovimentacaoId" value="@item.MovimentacaoId" />
                        <div class="campo campo-inline">
                            <label class="campo-rotulo">Motivo da recusa</label>
                            <input name="MotivoRecusa" class="campo-entrada" />
                        </div>
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="senha-wallet-recusar-@item.MovimentacaoId">Senha da wallet</label>
                            <input id="senha-wallet-recusar-@item.MovimentacaoId" name="SenhaWallet" type="password" autocomplete="current-password" class="campo-entrada" required />
                        </div>
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="pareamento-recusar-@item.MovimentacaoId">Código de pareamento</label>
                            <input id="pareamento-recusar-@item.MovimentacaoId" name="CodigoPareamento" type="password" autocomplete="one-time-code" class="campo-entrada" required />
                        </div>
                        <p class="campo-ajuda" data-operacao-status role="status" aria-live="polite"></p>
                        <p class="campo-erro" data-operacao-error role="alert" tabindex="-1" hidden></p>
                        <button type="submit" class="botao botao-secundario">Assinar e recusar recebimento</button>
                    </form>
                </div>
            </section>
        }
    </div>
}

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-recebimento-operacao]').forEach(function (form) {
                var tipo = form.dataset.recebimentoOperacao;
                var button = form.querySelector('button[type="submit"]');
                var password = form.querySelector('[name="SenhaWallet"]');
                var pairing = form.querySelector('[name="CodigoPareamento"]');
                var status = form.querySelector('[data-operacao-status]');
                var error = form.querySelector('[data-operacao-error]');
                var antiForgery = form.querySelector('input[name="__RequestVerificationToken"]').value;

                function payload() {
                    var value = function (name) { return form.querySelector('[name="' + name + '"]').value; };
                    var dados = { movimentacaoId: Number(value('MovimentacaoId')) || 0 };
                    if (tipo === 'confirmar') dados.numeroLacreConferido = value('NumeroLacreConferido');
                    else dados.motivoRecusa = value('MotivoRecusa');
                    return dados;
                }

                async function post(url, body) {
                    var response = await fetch(url, {
                        method: 'POST', credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgery },
                        body: JSON.stringify(body)
                    });
                    var responseBody = await response.json().catch(function () { return {}; });
                    if (!response.ok) throw new Error(responseBody.message || 'Não foi possível confirmar esta operação.');
                    return responseBody;
                }

                form.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    error.hidden = true;
                    if (!form.checkValidity()) { form.reportValidity(); return; }

                    button.disabled = true;
                    form.setAttribute('aria-busy', 'true');
                    try {
                        status.textContent = 'Preparando a operação.';
                        var dados = payload();
                        var command = await post('/recebimento/' + tipo + '/comando', dados);
                        status.textContent = 'Aguardando assinatura na wallet.';
                        var walletResponse = await fetch(command.walletEndpoint + '/v1/proofs/signed-operation', {
                            method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Wallet-Pairing-Token': pairing.value },
                            body: JSON.stringify({ did: command.signerDid, password: password.value, operation: command.operation })
                        });
                        var wallet = await walletResponse.json().catch(function () { return {}; });
                        if (!walletResponse.ok) throw new Error(wallet.message || 'A wallet recusou a assinatura.');
                        password.value = '';
                        status.textContent = 'Confirmando a operação no ledger.';
                        var request = tipo === 'confirmar' ? { recebimento: dados, operation: wallet.operation } : { recusa: dados, operation: wallet.operation };
                        var result = await post('/recebimento/' + tipo + '/prova', request);
                        window.location.assign(result.redirectUrl);
                    } catch (exception) {
                        password.value = '';
                        status.textContent = '';
                        error.textContent = exception.message;
                        error.hidden = false;
                        error.focus();
                    } finally {
                        button.disabled = false;
                        form.removeAttribute('aria-busy');
                    }
                });
            });
        })();
    </script>
}

@section Styles {
    <style>
        .pagina-cabecalho { margin-bottom: 1.5rem; }
        .pagina-cabecalho h1 { margin-bottom: 0.25rem; }

        .painel-vazio {
            border: 1px dashed var(--cor-borda-forte);
            border-radius: var(--raio);
            padding: 2rem 1.5rem;
            text-align: center;
            color: var(--cor-texto-suave);
        }

        .painel-vazio-icone {
            display: inline-flex;
            color: var(--cor-texto-fraco);
            margin-bottom: 0.5rem;
        }

        .lista-recebimento {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            max-width: 720px;
        }

        .item-recebimento { padding: 1.25rem 1.5rem; }

        .item-recebimento-cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }

        .item-recebimento-rotulo {
            font-weight: 600;
            font-size: 1rem;
        }

        .item-recebimento-descricao {
            margin: 0.125rem 0 0;
            color: var(--cor-texto-suave);
            font-size: 0.875rem;
        }

        .item-recebimento-detalhes {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.75rem;
            margin: 0 0 1rem;
            padding: 0.75rem 0;
            border-top: 1px solid var(--cor-borda);
            border-bottom: 1px solid var(--cor-borda);
        }

        .item-recebimento-detalhes dt {
            font-size: 0.75rem;
            color: var(--cor-texto-fraco);
            margin-bottom: 0.125rem;
        }

        .item-recebimento-detalhes dd {
            margin: 0;
            font-size: 0.875rem;
        }

        .item-recebimento-acoes {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .formulario-inline {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .campo-inline { margin-bottom: 0; }

        @@media (max-width: 640px) {
            .item-recebimento-detalhes { grid-template-columns: 1fr; }
            .item-recebimento-acoes { grid-template-columns: 1fr; }
        }
    </style>
}
