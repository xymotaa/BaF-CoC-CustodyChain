@{
    string tituloPagina = ViewData["Title"]?.ToString() ?? "CustodyChain";
    string nomeUsuario = User.Identity?.Name ?? "";
    string perfilUsuario = User.FindFirst("perfil_nome")?.Value ?? "";
    string iniciais = string.Concat(nomeUsuario.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(parte => char.ToUpperInvariant(parte[0])));
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@tituloPagina — CustodyChain</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#conteudo-principal">Ir para o conteúdo principal</a>
    @await Html.PartialAsync("_IconesSvg")

    <div class="app-shell">
        <aside id="sidebar-principal" class="sidebar">
            <div class="sidebar-marca">
                <!-- <span class="sidebar-marca-selo"></span>-->
                <span>Custody Chain</span>
            </div>
            @await Html.PartialAsync("_SidebarNav")
        </aside>

        <header class="navbar">
            <div class="navbar-esquerda">
                <button id="sidebar-toggle" type="button" class="navbar-toggle-btn"
                        aria-label="Abrir menu de navegação" aria-controls="sidebar-principal" aria-expanded="false">
                    <svg width="20" height="20"><use href="#icone-menu" /></svg>
                </button>
            </div>

            <div class="navbar-usuario">
                <span class="navbar-usuario-avatar">@iniciais</span>
                <div>
                    <div>@nomeUsuario</div>
                    <div class="navbar-usuario-perfil">@perfilUsuario</div>
                </div>
                <form asp-controller="Autenticacao" asp-action="Sair" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="botao-sair" title="Sair" aria-label="Sair">
                        <svg width="18" height="18"><use href="#icone-sair" /></svg>
                    </button>
                </form>
            </div>
        </header>

        <button type="button" class="sidebar-scrim" aria-label="Fechar menu de navegação" tabindex="-1"></button>

        <main id="conteudo-principal" class="main-content" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/ui/operacao-wallet.js" asp-append-version="true"></script>
    <script src="~/js/shell.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
