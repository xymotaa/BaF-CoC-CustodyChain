@model CustodyChain.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Painel";
}

<div class="painel-metricas">
    <div class="cartao painel-metrica">
        <span class="painel-metrica-rotulo">Vestígios registrados</span>
        <span class="painel-metrica-valor">@Model.TotalVestigios</span>
    </div>
    <div class="cartao painel-metrica">
        <span class="painel-metrica-rotulo">Processos ativos</span>
        <span class="painel-metrica-valor">@Model.TotalProcessosAtivos</span>
    </div>
    <div class="cartao painel-metrica">
        <span class="painel-metrica-rotulo">Registros pendentes no ledger</span>
        <span class="painel-metrica-valor">@Model.RegistrosLedgerPendentes</span>
    </div>
</div>

<section class="cartao painel-secao">
    <h2>Vestígios por estado</h2>

    @if (Model.ContagemPorEstado.Count == 0)
    {
        <div class="painel-vazio">
            <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-vestigio" /></svg></span>
            <p>Nenhum vestígio cadastrado ainda.</p>
            <p class="campo-ajuda">Cadastros feitos pela Central de Custódia aparecem aqui, agrupados por estado da cadeia.</p>
        </div>
    }
    else
    {
        <ul class="painel-lista-estados">
            @foreach (var item in Model.ContagemPorEstado)
            {
                <li>
                    <span>@item.Estado</span>
                    <span class="mono">@item.Quantidade</span>
                </li>
            }
        </ul>
    }
</section>
