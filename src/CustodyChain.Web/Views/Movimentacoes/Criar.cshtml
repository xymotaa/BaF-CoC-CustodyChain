@model CustodyChain.Web.Models.ViewModels.CriarMovimentacaoViewModel
@{
    ViewData["Title"] = "Movimentações";
}

<div class="pagina-cabecalho pagina-cabecalho-acao">
    <div>
        <h1>Movimentações</h1>
        <p class="campo-ajuda">Remessa de um vestígio sob sua custódia para outro interveniente.</p>
    </div>
    <nav class="navegacao-operacional" aria-label="Navegação da cadeia de custódia">
        <a class="botao botao-secundario" href="/auditoria">Consultar histórico</a>
    </nav>
</div>

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagem</span>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>Verifique os campos destacados abaixo.</span>
    </div>
}

@if (Model.VestigiosDisponiveis.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-movimentacao" /></svg></span>
        <p>Nenhum vestígio disponível para remessa.</p>
        <p class="campo-ajuda">A primeira remessa exige coleta confirmada; as seguintes exigem custódia recebida e VC vigente.</p>
    </div>
}
else
{
    <form id="criar-remessa-form" novalidate class="formulario-vestigio formulario-operacional">
        @Html.AntiForgeryToken()

        <section class="cartao secao-formulario secao-operacional">
            <div class="grade-campos grade-2col">
                <div class="campo">
                    <label asp-for="VestigioId" class="campo-rotulo"></label>
                    <select asp-for="VestigioId" class="campo-entrada @(ViewData.ModelState["VestigioId"]?.Errors.Count > 0 ? "campo-invalido" : "")">
                        <option value="">Selecione o vestígio</option>
                        @foreach (var opcao in Model.VestigiosDisponiveis)
                        {
                            <option value="@opcao.Id">@opcao.RotuloEvidencia — @opcao.Descricao</option>
                        }
                    </select>
                    <span asp-validation-for="VestigioId" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="DestinoId" class="campo-rotulo"></label>
                    <select asp-for="DestinoId" class="campo-entrada @(ViewData.ModelState["DestinoId"]?.Errors.Count > 0 ? "campo-invalido" : "")">
                        <option value="">Selecione o destino</option>
                        @foreach (var opcao in Model.DestinosDisponiveis)
                        {
                            <option value="@opcao.Id">@opcao.Nome — @opcao.Perfil</option>
                        }
                    </select>
                    <span asp-validation-for="DestinoId" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="DataHoraSaida" class="campo-rotulo"></label>
                    <input asp-for="DataHoraSaida" type="datetime-local" class="campo-entrada @(ViewData.ModelState["DataHoraSaida"]?.Errors.Count > 0 ? "campo-invalido" : "")" />
                    <span asp-validation-for="DataHoraSaida" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="CodigoRastreamento" class="campo-rotulo"></label>
                    <input asp-for="CodigoRastreamento" class="campo-entrada mono" />
                    <span asp-validation-for="CodigoRastreamento" class="campo-erro"></span>
                </div>
            </div>
        </section>

        <section class="cartao secao-formulario secao-operacional operacao-assinada" aria-labelledby="assinatura-remessa-title">
            <h2 id="assinatura-remessa-title">Assinatura da remessa</h2>
            <p class="campo-ajuda">A wallet do custodiante ou coletor autorizado assina a remessa antes da confirmação no ledger.</p>
            <div class="grade-campos grade-2col">
                <div class="campo">
                    <label for="senha-wallet" class="campo-rotulo">Senha da wallet</label>
                    <input id="senha-wallet" name="SenhaWallet" type="password" autocomplete="current-password" class="campo-entrada" required />
                </div>
                <div class="campo">
                    <label for="codigo-pareamento" class="campo-rotulo">Código de pareamento</label>
                    <input id="codigo-pareamento" name="CodigoPareamento" type="password" autocomplete="one-time-code" class="campo-entrada" required />
                </div>
            </div>
            <p class="campo-ajuda estado-operacao" data-operacao-status role="status" aria-live="polite"></p>
            <p class="campo-erro" data-operacao-error role="alert" tabindex="-1" hidden></p>
        </section>

        <div class="formulario-acoes acoes-formulario">
            <button type="submit" class="botao botao-primario">Assinar e registrar remessa</button>
        </div>
    </form>
}

@section Styles {
    <style>
        .pagina-cabecalho { margin-bottom: 1.5rem; }
        .pagina-cabecalho h1 { margin-bottom: 0.25rem; }

        .formulario-vestigio {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            max-width: 760px;
        }

        .secao-formulario { padding: 1.5rem; }

        .grade-campos { display: grid; gap: 0 1rem; }
        .grade-2col { grid-template-columns: 1fr 1fr; }

        @@media (max-width: 640px) {
            .grade-2col { grid-template-columns: 1fr; }
        }

        .formulario-acoes { display: flex; justify-content: flex-end; }

        .painel-vazio {
            border: 1px dashed var(--cor-borda-forte);
            border-radius: var(--raio);
            padding: 2rem 1.5rem;
            text-align: center;
            color: var(--cor-texto-suave);
        }

        .painel-vazio-icone {
            display: inline-flex;
            color: var(--cor-texto-fraco);
            margin-bottom: 0.5rem;
        }

        .painel-vazio p { margin: 0 auto 0.25rem; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('criar-remessa-form');
            if (!form) return;
            var walletUi = window.CustodyChainWallet;
            if (!walletUi) return;
            var button = form.querySelector('button[type="submit"]');
            var password = document.getElementById('senha-wallet');
            var pairing = document.getElementById('codigo-pareamento');
            var status = form.querySelector('[data-operacao-status]');
            var error = form.querySelector('[data-operacao-error]');
            var antiForgery = form.querySelector('input[name="__RequestVerificationToken"]').value;

            function payload() {
                var field = function (name) { return form.querySelector('[name="' + name + '"]'); };
                return {
                    vestigioId: Number(field('VestigioId').value) || null,
                    destinoId: Number(field('DestinoId').value) || null,
                    dataHoraSaida: field('DataHoraSaida').value,
                    codigoRastreamento: field('CodigoRastreamento').value || null
                };
            }

            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                walletUi.limparErro(error);
                if (!form.checkValidity()) { form.reportValidity(); return; }

                walletUi.definirProcessamento({ botao: button, painel: form, processando: true });
                try {
                    walletUi.definirStatus(status, 'Preparando a remessa.', 'processando');
                    var command = await walletUi.requisicaoAplicacao({
                        url: '/movimentacoes/criar/comando', token: antiForgery, body: payload(),
                        mensagemErro: 'Não foi possível preparar a remessa.'
                    });
                    walletUi.definirStatus(status, 'Aguardando assinatura na wallet.', 'aguardando');
                    var assinatura = await walletUi.requisicaoWallet({
                        endpoint: command.walletEndpoint, path: '/v1/proofs/signed-operation', pairingToken: pairing.value,
                        body: { did: command.signerDid, password: password.value, operation: command.operation },
                        mensagemErro: 'A wallet recusou a assinatura da remessa.'
                    });
                    walletUi.limparCamposSensíveis(password, pairing);
                    walletUi.definirStatus(status, 'Confirmando a remessa no ledger.', 'processando');
                    var result = await walletUi.requisicaoAplicacao({
                        url: '/movimentacoes/criar/prova', token: antiForgery,
                        body: { remessa: payload(), operation: assinatura.operation },
                        mensagemErro: 'Não foi possível registrar a remessa.'
                    });
                    window.location.assign(result.redirectUrl);
                } catch (exception) {
                    walletUi.limparCamposSensíveis(password, pairing);
                    walletUi.definirStatus(status, '', 'erro');
                    walletUi.exibirErro(error, exception.message);
                } finally {
                    walletUi.definirProcessamento({ botao: button, painel: form, processando: false });
                }
            });
        })();
    </script>
}
