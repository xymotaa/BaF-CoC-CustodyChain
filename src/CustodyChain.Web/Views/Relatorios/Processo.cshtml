@model CustodyChain.Web.Models.ViewModels.RelatorioProcessoViewModel
@{
    ViewData["Title"] = "Relatórios";
}

<div class="pagina-cabecalho">
    <h1>Relatório do processo</h1>
    <p class="campo-ajuda">Apresentação visual dos vestígios de um processo, com exportação em PDF e XML.</p>
</div>

<form asp-controller="Relatorios" asp-action="Processo" method="get" class="formulario-busca">
    <div class="campo campo-filtro">
        <label for="processoId" class="campo-rotulo sr-only">Processo</label>
        <select id="processoId" name="processoId" class="campo-entrada" onchange="this.form.submit()">
            <option value="">Selecione o processo</option>
            @foreach (var opcao in Model.ProcessosDisponiveis)
            {
                <option value="@opcao.Id" selected="@(opcao.Id == Model.ProcessoId)">@opcao.Numero @(opcao.NomeOperacao is not null ? $"— {opcao.NomeOperacao}" : "")</option>
            }
        </select>
    </div>
    <noscript><button type="submit" class="botao botao--secundario">Buscar</button></noscript>
</form>

@if (Model.ProcessoId is null)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-relatorio" /></svg></span>
        <p>Selecione um processo para gerar o relatório.</p>
    </div>
}
else
{
    <div class="relatorio-acoes">
        <a href="/relatorios/processo/pdf?processoId=@Model.ProcessoId" class="botao botao--primario">Exportar PDF</a>
        <a href="/relatorios/processo/xml?processoId=@Model.ProcessoId" class="botao botao--secundario">Exportar XML</a>
    </div>

    <section class="cartao relatorio-dados-processo">
        <dl class="item-recebimento-detalhes relatorio-grade-processo">
            <div>
                <dt>Número</dt>
                <dd class="mono">@Model.ProcessoNumero</dd>
            </div>
            <div>
                <dt>Situação</dt>
                <dd><span class="selo">@Model.ProcessoSituacao</span></dd>
            </div>
            <div>
                <dt>Operação</dt>
                <dd>@(Model.ProcessoNomeOperacao ?? "—")</dd>
            </div>
            <div>
                <dt>Órgão de origem</dt>
                <dd>@(Model.ProcessoOrgaoOrigem ?? "—")</dd>
            </div>
            <div>
                <dt>Data de abertura</dt>
                <dd>@(Model.ProcessoDataAbertura?.ToString("dd/MM/yyyy") ?? "—")</dd>
            </div>
        </dl>
    </section>

    <h2 class="relatorio-subtitulo">Vestígios (@Model.Vestigios.Count)</h2>

    @if (Model.Vestigios.Count == 0)
    {
        <div class="painel-vazio">
            <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-vestigio" /></svg></span>
            <p>Nenhum vestígio cadastrado para este processo.</p>
        </div>
    }
    else
    {
        <div class="tabela-wrapper">
            <table class="tabela-forense">
                <thead>
                    <tr>
                        <th>Rótulo</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Custódia atual</th>
                        <th>Hash</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Vestigios)
                    {
                        <tr>
                            <td>
                                <span class="mono">@item.RotuloEvidencia</span>
                                <div class="tabela-descricao">@item.Descricao</div>
                            </td>
                            <td>@item.TipoVestigio</td>
                            <td><span class="selo">@item.Estado</span></td>
                            <td>@(item.CustodianteNome ?? "—")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.HashSha256))
                                {
                                    <span class="mono tabela-hash" title="@item.HashSha256">@item.HashSha256[..12]…</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
