@model CustodyChain.Web.Models.ViewModels.RotacionarChaveDidViewModel
@{
    ViewData["Title"] = "Rotacionar chave da identidade";
}

<div class="pagina-cabecalho">
    <h1>Rotacionar chave da identidade</h1>
</div>

<section id="rotation-panel" class="cartao painel-operacao-wallet painel-rotacao"
         data-wallet-endpoint="@Model.WalletEndpoint" data-did="@Model.Did">
    @Html.AntiForgeryToken()
    <div class="painel-rotacao-conteudo">
        <dl class="resumo-identidade">
            <dt>DID</dt><dd class="mono">@Model.Did</dd>
            <dt>Chave atual</dt><dd class="mono">@Model.KeyIdAtual</dd>
            <dt>Versão do documento</dt><dd>@Model.DocumentVersion</dd>
            <dt>Nova chave</dt><dd id="new-key" class="mono">Será criada pela wallet após a confirmação.</dd>
        </dl>

        <div class="alerta alerta-aviso">
            Após a confirmação, esta sessão será encerrada e a chave atual não poderá assinar novas operações.
        </div>
        <div id="rotation-error" class="alerta alerta-erro" role="alert" tabindex="-1" hidden></div>

        <div class="campo">
            <label class="campo-rotulo" for="wallet-password">Senha da wallet</label>
            <input id="wallet-password" class="campo-entrada" type="password"
                   autocomplete="current-password" required />
        </div>
        <div class="campo">
            <label class="campo-rotulo" for="pairing-token">Código de pareamento</label>
            <input id="pairing-token" class="campo-entrada" type="password" autocomplete="off" required />
        </div>
        <label class="confirmacao-rotacao" for="rotation-confirmation">
            <input id="rotation-confirmation" type="checkbox" />
            Entendo que precisarei entrar novamente usando a nova chave.
        </label>

        <button id="rotate" class="botao botao--primario" type="button">Criar e ativar nova chave</button>
        <p id="rotation-status" role="status" aria-live="polite" class="campo-ajuda estado-operacao"></p>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const wallet = window.CustodyChainWallet;
            const panel = document.getElementById('rotation-panel');
            const button = document.getElementById('rotate');
            const error = document.getElementById('rotation-error');
            const status = document.getElementById('rotation-status');
            const password = document.getElementById('wallet-password');
            const pairing = document.getElementById('pairing-token');
            const confirmation = document.getElementById('rotation-confirmation');
            const newKey = document.getElementById('new-key');
            const token = wallet.obterTokenAntiforgery(panel);
            const walletEndpoint = panel.dataset.walletEndpoint;
            const did = panel.dataset.did;

            button.addEventListener('click', async () => {
                wallet.limparErro(error);
                if (!password.value || !pairing.value || !confirmation.checked) {
                    wallet.exibirErro(error, 'Informe a senha, o código de pareamento e confirme a troca da chave.');
                    return;
                }

                wallet.definirProcessamento({ botao: button, painel: panel, processando: true });
                let candidate = null;
                let ledgerConfirmed = false;
                try {
                    wallet.definirStatus(status, 'Criando a nova chave na wallet.', 'aguardando');
                    candidate = await wallet.requisicaoWallet({
                        endpoint: walletEndpoint, path: '/v1/key-rotations/candidates', pairingToken: pairing.value,
                        body: { did, password: password.value }, mensagemErro: 'A wallet recusou a rotação.'
                    });
                    newKey.textContent = candidate.keyId;

                    wallet.definirStatus(status, 'Preparando o comando de rotação.', 'processando');
                    const command = await wallet.requisicaoAplicacao({
                        url: '/identidade/chave/rotacao/comando', token,
                        body: { keyId: candidate.keyId, publicKeyMultibase: candidate.publicKeyMultibase },
                        mensagemErro: 'Não foi possível rotacionar a chave.'
                    });

                    wallet.definirStatus(status, 'Aguardando assinatura com a chave atual e a nova chave.', 'aguardando');
                    const proofs = await wallet.requisicaoWallet({
                        endpoint: walletEndpoint, path: '/v1/proofs/did-key-rotation', pairingToken: pairing.value,
                        body: { did, password: password.value, candidateId: candidate.candidateId, command },
                        mensagemErro: 'A wallet recusou a rotação.'
                    });
                    password.value = '';

                    wallet.definirStatus(status, 'Confirmando a rotação no ledger.', 'processando');
                    const result = await wallet.requisicaoAplicacao({
                        url: '/identidade/chave/rotacao/prova', token,
                        body: { command, currentKeyProof: proofs.currentKeyProof, newKeyProof: proofs.newKeyProof },
                        mensagemErro: 'Não foi possível rotacionar a chave.'
                    });
                    ledgerConfirmed = true;

                    wallet.definirStatus(status, 'Ativando a nova chave na wallet.', 'processando');
                    await wallet.requisicaoWallet({
                        endpoint: walletEndpoint, path: '/v1/key-rotations/confirm', pairingToken: pairing.value,
                        body: { did, candidateId: candidate.candidateId, keyId: result.keyId },
                        mensagemErro: 'A wallet não confirmou a nova chave.'
                    });
                    wallet.definirStatus(status, 'Chave rotacionada. Redirecionando para uma nova autenticação.', 'sucesso');
                    window.location.assign(result.redirectUrl);
                } catch (exception) {
                    if (ledgerConfirmed) {
                        button.dataset.reconciliacaoPendente = 'true';
                    }
                    wallet.exibirErro(error, ledgerConfirmed
                        ? `${exception.message} O ledger confirmou a rotação; não tente criar outra chave antes de reconciliar a wallet.`
                        : `${exception.message} A chave candidata foi preservada para uma nova tentativa segura.`);
                    wallet.definirStatus(status, ledgerConfirmed
                        ? 'A rotação foi confirmada no ledger, mas a wallet precisa ser reconciliada.'
                        : 'A rotação não foi confirmada. Revise os dados antes de tentar novamente.', ledgerConfirmed ? 'pendente' : 'erro');
                } finally {
                    wallet.limparCamposSensíveis(password, pairing);
                    wallet.definirProcessamento({ botao: button, painel: panel, processando: false });
                    button.disabled = button.dataset.reconciliacaoPendente === 'true';
                }
            });
        })();
    </script>
}
