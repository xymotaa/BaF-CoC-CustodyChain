@model CustodyChain.Web.Models.ViewModels.RecuperarIdentidadeViewModel
@{
    ViewData["Title"] = "Recuperar identidade DID";
}

<div class="pagina-cabecalho">
    <h1>Recuperar identidade DID</h1>
    <p class="campo-ajuda">Crie uma chave candidata na nova wallet e entregue o pacote assinado a um administrador. A aplicação nunca recebe sua chave privada.</p>
</div>

<section id="recovery-panel" class="cartao painel-operacao-wallet painel-recuperacao" data-wallet-endpoint="@Model.WalletEndpoint">
    @Html.AntiForgeryToken()
    <div class="alerta alerta-aviso">
        A recuperação depende de aprovação administrativa. A chave anterior será marcada como comprometida no ledger.
    </div>
    <div id="recovery-error" class="alerta alerta-erro" role="alert" tabindex="-1" hidden></div>

    <div class="campo">
        <label class="campo-rotulo" for="did">DID a recuperar</label>
        <input id="did" class="campo-entrada" autocomplete="username" spellcheck="false" placeholder="did:legal:expert:..." required />
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="wallet-password">Senha da nova wallet</label>
        <input id="wallet-password" class="campo-entrada" type="password" autocomplete="new-password" required />
    </div>
    <div class="campo">
        <label class="campo-rotulo" for="pairing-token">Código de pareamento</label>
        <input id="pairing-token" class="campo-entrada" type="password" autocomplete="off" required />
    </div>
    <button id="create-recovery" class="botao botao-primario" type="button">Criar pacote de recuperação</button>
    <p id="recovery-status" role="status" aria-live="polite" class="campo-ajuda estado-operacao"></p>

    <div id="recovery-package" class="campo" hidden>
        <label class="campo-rotulo" for="package">Pacote assinado para o administrador</label>
        <textarea id="package" class="campo-entrada mono" rows="12" readonly></textarea>
        <p class="campo-ajuda">Envie este pacote por um canal seguro ao administrador. Ele expira em cinco minutos.</p>
        <button id="copy-package" class="botao botao-secundario" type="button">Copiar pacote</button>
        <button id="confirm-recovery" class="botao botao-secundario" type="button">Confirmar chave após aprovação</button>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const wallet = window.CustodyChainWallet;
            const panel = document.getElementById('recovery-panel');
            const button = document.getElementById('create-recovery');
            const error = document.getElementById('recovery-error');
            const status = document.getElementById('recovery-status');
            const did = document.getElementById('did');
            const password = document.getElementById('wallet-password');
            const pairing = document.getElementById('pairing-token');
            const packagePanel = document.getElementById('recovery-package');
            const packageField = document.getElementById('package');
            const copyButton = document.getElementById('copy-package');
            const confirmButton = document.getElementById('confirm-recovery');
            const token = wallet.obterTokenAntiforgery(panel);
            const walletEndpoint = panel.dataset.walletEndpoint;
            let candidate = null;

            button.addEventListener('click', async () => {
                wallet.limparErro(error);
                packagePanel.hidden = true;
                if (!wallet.camposPreenchidos(did, password, pairing)) {
                    wallet.exibirErro(error, 'Informe o DID, a senha da nova wallet e o código de pareamento.');
                    return;
                }
                wallet.definirProcessamento({ botao: button, painel, processando: true });
                try {
                    wallet.definirStatus(status, 'Consultando o estado atual do DID.', 'processando');
                    const preparation = await wallet.requisicaoAplicacao({
                        url: `/recuperar-identidade/preparar?did=${encodeURIComponent(did.value.trim())}`,
                        token, method: 'GET', mensagemErro: 'Não foi possível preparar a recuperação.'
                    });
                    wallet.definirStatus(status, 'Criando chave candidata na wallet.', 'aguardando');
                    candidate = await wallet.requisicaoWallet({
                        endpoint: walletEndpoint, path: '/v1/key-recoveries/candidates', pairingToken: pairing.value,
                        body: { did: preparation.did, keyId: preparation.keyId, password: password.value },
                        mensagemErro: 'A wallet recusou a solicitação.'
                    });
                    wallet.definirStatus(status, 'Montando o pedido de recuperação.', 'processando');
                    const request = await wallet.requisicaoAplicacao({
                        url: '/recuperar-identidade/pedido', token,
                        body: { did: preparation.did, keyId: candidate.keyId, publicKeyMultibase: candidate.publicKeyMultibase },
                        mensagemErro: 'Não foi possível preparar a recuperação.'
                    });
                    wallet.definirStatus(status, 'Aguardando assinatura do pedido na wallet.', 'aguardando');
                    const proof = await wallet.requisicaoWallet({
                        endpoint: walletEndpoint, path: '/v1/proofs/did-key-recovery-request', pairingToken: pairing.value,
                        body: { did: preparation.did, password: password.value, candidateId: candidate.candidateId, request },
                        mensagemErro: 'A wallet recusou a solicitação.'
                    });
                    packageField.value = JSON.stringify({ request, candidateSignature: proof.signature }, null, 2);
                    packagePanel.hidden = false;
                    wallet.definirStatus(status, 'Pacote criado. Envie-o ao administrador antes da expiração.', 'sucesso');
                } catch (exception) {
                    wallet.exibirErro(error, exception.message);
                    wallet.definirStatus(status, 'O pacote não foi criado. Revise os dados e tente novamente.', 'erro');
                } finally {
                    wallet.limparCamposSensíveis(password, pairing);
                    wallet.definirProcessamento({ botao: button, painel, processando: false });
                }
            });

            copyButton.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(packageField.value);
                    wallet.definirStatus(status, 'Pacote copiado.', 'sucesso');
                } catch {
                    packageField.select();
                    wallet.definirStatus(status, 'Selecione e copie o pacote manualmente.', 'pendente');
                }
            });

            confirmButton.addEventListener('click', async () => {
                wallet.limparErro(error);
                if (!candidate) {
                    wallet.exibirErro(error, 'Crie novamente o pacote nesta sessão para confirmar a chave candidata.');
                    return;
                }
                if (!wallet.camposPreenchidos(pairing)) {
                    wallet.exibirErro(error, 'Informe novamente o código de pareamento para confirmar a chave na wallet.');
                    return;
                }
                wallet.definirProcessamento({ botao: confirmButton, painel, processando: true });
                try {
                    wallet.definirStatus(status, 'Verificando a aprovação no ledger.', 'processando');
                    const confirmation = await wallet.requisicaoAplicacao({
                        url: `/recuperar-identidade/confirmar?did=${encodeURIComponent(candidate.did)}&keyId=${encodeURIComponent(candidate.keyId)}`,
                        token, method: 'GET', mensagemErro: 'Não foi possível confirmar a recuperação.'
                    });
                    if (!confirmation.confirmed) throw new Error('A recuperação ainda não foi aprovada no ledger.');
                    wallet.definirStatus(status, 'Ativando a nova chave na wallet.', 'processando');
                    await wallet.requisicaoWallet({
                        endpoint: walletEndpoint, path: '/v1/key-rotations/confirm', pairingToken: pairing.value,
                        body: { did: candidate.did, candidateId: candidate.candidateId, keyId: candidate.keyId },
                        mensagemErro: 'A wallet não confirmou a nova chave.'
                    });
                    confirmButton.dataset.completed = 'true';
                    wallet.definirStatus(status, 'Chave ativada na wallet. Você já pode entrar com a identidade recuperada.', 'sucesso');
                } catch (exception) {
                    wallet.exibirErro(error, exception.message);
                    wallet.definirStatus(status, 'A confirmação ainda não foi concluída.', 'pendente');
                } finally {
                    wallet.limparCamposSensíveis(pairing);
                    wallet.definirProcessamento({ botao: confirmButton, painel, processando: false });
                    confirmButton.disabled = confirmButton.dataset.completed === 'true';
                }
            });
        })();
    </script>
}

@section Styles {
    <style>
        .pagina-cabecalho { margin-bottom: 1.5rem; }
        .painel-recuperacao { max-width: 720px; }
        .painel-recuperacao .campo { margin-top: 1rem; }
        .painel-recuperacao .botao { margin-top: 1rem; }
        .painel-recuperacao textarea { width: 100%; resize: vertical; }
    </style>
}
