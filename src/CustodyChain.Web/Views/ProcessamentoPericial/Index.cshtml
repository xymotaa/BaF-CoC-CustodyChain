@model CustodyChain.Web.Models.ViewModels.ProcessamentoPericialListaViewModel
@{
    ViewData["Title"] = "Processamento pericial";
}

<div class="pagina-cabecalho">
    <h1>Processamento pericial</h1>
    <p class="campo-ajuda">Vestígios designados a você. Receba e rompa o lacre para liberar o exame.</p>
</div>

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagemSucesso</span>
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>@mensagemErro</span>
    </div>
}

@if (Model.Pericias.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-pericia" /></svg></span>
        <p>Nenhuma perícia designada a você no momento.</p>
    </div>
}
else
{
    <div class="lista-recebimento">
        @foreach (var item in Model.Pericias)
        {
            <section class="cartao item-recebimento">
                <div class="item-recebimento-cabecalho">
                    <div>
                        <span class="mono item-recebimento-rotulo">@item.RotuloEvidencia</span>
                        <p class="item-recebimento-descricao">@item.Descricao</p>
                    </div>
                    <span class="selo">@item.Situacao</span>
                </div>

                @if (!item.CredencialPermissaoValida)
                {
                    <div class="alerta alerta-erro" role="alert">
                        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
                        <span>Credencial de permissão inválida para este vestígio (RN10). Rompimento bloqueado.</span>
                    </div>
                }

                @if (item.Situacao == "DESIGNADA")
                {
                    <form class="formulario-inline" data-operacao-assinada-form data-pericia-id="@item.PericiaId"
                          data-preparar-url="/processamento-pericial/@item.PericiaId/receber/comando"
                          data-concluir-url="/processamento-pericial/@item.PericiaId/receber/prova">
                        @Html.AntiForgeryToken()
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="receber-senha-@item.PericiaId">Senha da wallet</label>
                            <input id="receber-senha-@item.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required />
                        </div>
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="receber-pareamento-@item.PericiaId">Código de pareamento</label>
                            <input id="receber-pareamento-@item.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required />
                        </div>
                        <button type="submit" class="botao botao-primario">Assinar e receber vestígio</button>
                        <p class="campo-ajuda" data-operacao-status role="status" aria-atomic="true"></p>
                        <div class="alerta alerta-erro" data-operacao-error role="alert" tabindex="-1" hidden></div>
                    </form>
                }
                else if (item.Situacao == "RECEBIDA")
                {
                    <form class="formulario-inline" data-operacao-assinada-form data-pericia-id="@item.PericiaId"
                          data-preparar-url="/processamento-pericial/@item.PericiaId/romper-lacre/comando"
                          data-concluir-url="/processamento-pericial/@item.PericiaId/romper-lacre/prova">
                        @Html.AntiForgeryToken()
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="lacre-justificativa-@item.PericiaId">Justificativa do rompimento (lacre @item.NumeroLacreAtual)</label>
                            <input id="lacre-justificativa-@item.PericiaId" name="Justificativa" class="campo-entrada" required />
                        </div>
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="lacre-senha-@item.PericiaId">Senha da wallet</label>
                            <input id="lacre-senha-@item.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required />
                        </div>
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="lacre-pareamento-@item.PericiaId">Código de pareamento</label>
                            <input id="lacre-pareamento-@item.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required />
                        </div>
                        <button type="submit" class="botao botao-primario" @(item.CredencialPermissaoValida ? "" : "disabled")>Assinar e romper lacre</button>
                        <p class="campo-ajuda" data-operacao-status role="status" aria-atomic="true"></p>
                        <div class="alerta alerta-erro" data-operacao-error role="alert" tabindex="-1" hidden></div>
                    </form>
                }
                else if (item.Situacao == "EM_EXECUCAO")
                {
                    <details class="operacao-amostra-detalhes">
                        <summary>Fracionar</summary>
                        <form class="formulario-inline" data-operacao-assinada-form data-pericia-id="@item.PericiaId" data-preparar-url="/processamento-pericial/@item.PericiaId/fracionar/comando" data-concluir-url="/processamento-pericial/@item.PericiaId/fracionar/prova">
                            @Html.AntiForgeryToken()
                            <div class="campo campo-inline">
                                <label class="campo-rotulo" for="rotulo-resultante-@item.PericiaId">Rótulo de evidência do item resultante</label>
                                <input id="rotulo-resultante-@item.PericiaId" name="RotuloEvidenciaResultante" class="campo-entrada mono" required />
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo" for="descricao-resultante-@item.PericiaId">Descrição do item resultante</label>
                                <input id="descricao-resultante-@item.PericiaId" name="DescricaoResultante" class="campo-entrada" required />
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo">Quantidade descrita</label>
                                <input name="QuantidadeDescrita" class="campo-entrada" />
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo">Justificativa</label>
                                <input name="Justificativa" class="campo-entrada" required />
                            </div>
                            <div class="campo campo-inline"><label class="campo-rotulo">Senha da wallet</label><input name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required /></div>
                            <div class="campo campo-inline"><label class="campo-rotulo">Código de pareamento</label><input name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required /></div>
                            <button type="submit" class="botao botao-secundario">Assinar e fracionar</button><p class="campo-ajuda" data-operacao-status role="status" aria-atomic="true"></p><div class="alerta alerta-erro" data-operacao-error role="alert" tabindex="-1" hidden></div>
                        </form>
                    </details>

                    <details class="operacao-amostra-detalhes">
                        <summary>Unificar com outro vestígio do mesmo conjunto (RC: @item.RotuloConjunto)</summary>
                        <form asp-controller="ProcessamentoPericial" asp-action="Unificar" method="post" class="formulario-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="PericiaId" value="@item.PericiaId" />
                            <div class="campo campo-inline">
                                <label class="campo-rotulo">ID do(s) outro(s) vestígio(s) de origem (mesmo RC), separados por vírgula</label>
                                <input name="OutrosVestigiosOrigemIds" class="campo-entrada mono" placeholder="ex: 6, 7" required />
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo">Rótulo de evidência do item unificado</label>
                                <input name="RotuloEvidenciaResultante" class="campo-entrada mono" required />
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo">Descrição do item unificado</label>
                                <input name="DescricaoResultante" class="campo-entrada" required />
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo">Justificativa</label>
                                <input name="Justificativa" class="campo-entrada" required />
                            </div>
                            <button type="submit" class="botao botao-secundario">Registrar unificação</button>
                        </form>
                    </details>

                    <details class="operacao-amostra-detalhes">
                        <summary>Consumo ou exaurimento</summary>
                        <form class="formulario-inline" data-operacao-assinada-form data-pericia-id="@item.PericiaId"
                              data-preparar-url="/processamento-pericial/@item.PericiaId/consumir-exaurir/comando"
                              data-concluir-url="/processamento-pericial/@item.PericiaId/consumir-exaurir/prova">
                            @Html.AntiForgeryToken()
                            <div class="campo campo-inline">
                                <label class="campo-rotulo" for="amostra-tipo-@item.PericiaId">Tipo</label>
                                <select id="amostra-tipo-@item.PericiaId" name="Tipo" class="campo-entrada">
                                    <option value="CONSUMO">Consumo</option>
                                    <option value="EXAURIMENTO">Exaurimento</option>
                                </select>
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo" for="amostra-quantidade-@item.PericiaId">Quantidade descrita</label>
                                <input id="amostra-quantidade-@item.PericiaId" name="QuantidadeDescrita" class="campo-entrada" />
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo" for="amostra-justificativa-@item.PericiaId">Justificativa</label>
                                <input id="amostra-justificativa-@item.PericiaId" name="Justificativa" class="campo-entrada" required />
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo" for="amostra-senha-@item.PericiaId">Senha da wallet</label>
                                <input id="amostra-senha-@item.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required />
                            </div>
                            <div class="campo campo-inline">
                                <label class="campo-rotulo" for="amostra-pareamento-@item.PericiaId">Código de pareamento</label>
                                <input id="amostra-pareamento-@item.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required />
                            </div>
                            <button type="submit" class="botao botao-secundario">Assinar e registrar</button>
                            <p class="campo-ajuda" data-operacao-status role="status" aria-atomic="true"></p>
                            <div class="alerta alerta-erro" data-operacao-error role="alert" tabindex="-1" hidden></div>
                        </form>
                    </details>

                    <form class="formulario-inline formulario-laudo" data-laudo-form data-pericia-id="@item.PericiaId">
                        @Html.AntiForgeryToken()
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="laudo-conteudo-@item.PericiaId">Conteúdo do laudo</label>
                            <textarea id="laudo-conteudo-@item.PericiaId" name="Conteudo" rows="4" class="campo-entrada campo-textarea" required></textarea>
                        </div>
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="laudo-senha-@item.PericiaId">Senha da wallet</label>
                            <input id="laudo-senha-@item.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required />
                        </div>
                        <div class="campo campo-inline">
                            <label class="campo-rotulo" for="laudo-pareamento-@item.PericiaId">Código de pareamento</label>
                            <input id="laudo-pareamento-@item.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required />
                        </div>
                        <button type="submit" class="botao botao-primario">Assinar e emitir laudo</button>
                        <p class="campo-ajuda" data-laudo-status role="status" aria-atomic="true"></p>
                        <div class="alerta alerta-erro" data-laudo-error role="alert" tabindex="-1" hidden></div>
                    </form>
                }
            </section>
        }
    </div>
}

@section Scripts {
    <script>
        (() => {
            const post = async (url, antiForgery, body) => {
                const response = await fetch(url, {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgery },
                    body: JSON.stringify(body)
                });
                const payload = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(payload.message || 'Não foi possível emitir o laudo.');
                return payload;
            };

            document.querySelectorAll('[data-laudo-form]').forEach((form) => {
                const button = form.querySelector('button[type="submit"]');
                const content = form.querySelector('[name="Conteudo"]');
                const password = form.querySelector('[name="SenhaWallet"]');
                const pairing = form.querySelector('[name="CodigoPareamento"]');
                const status = form.querySelector('[data-laudo-status]');
                const error = form.querySelector('[data-laudo-error]');
                const antiForgery = form.querySelector('input[name="__RequestVerificationToken"]').value;
                const periciaId = form.dataset.periciaId;
                let signedOperation = null;

                content.addEventListener('input', () => { signedOperation = null; });
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    error.hidden = true;
                    if (!content.value.trim() || (!signedOperation && (!password.value || !pairing.value))) {
                        error.textContent = 'Informe o conteúdo do laudo, a senha e o código de pareamento da wallet.';
                        error.hidden = false;
                        error.focus();
                        return;
                    }

                    button.disabled = true;
                    form.setAttribute('aria-busy', 'true');
                    try {
                        if (!signedOperation) {
                            status.textContent = 'Preparando a operação de emissão do laudo.';
                            const command = await post(`/processamento-pericial/${periciaId}/emitir-laudo/comando`, antiForgery, {
                                conteudo: content.value
                            });
                            status.textContent = `Aguardando a assinatura do laudo ${command.numeroLaudo} na wallet.`;
                            const walletResponse = await fetch(`${command.walletEndpoint}/v1/proofs/signed-operation`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', 'X-Wallet-Pairing-Token': pairing.value },
                                body: JSON.stringify({ did: command.signerDid, password: password.value, operation: command.operation })
                            });
                            const wallet = await walletResponse.json().catch(() => ({}));
                            if (!walletResponse.ok) throw new Error(wallet.message || 'A wallet recusou a assinatura do laudo.');
                            signedOperation = wallet.operation;
                            password.value = '';
                        }

                        status.textContent = 'Confirmando a autorização no ledger.';
                        const result = await post(`/processamento-pericial/${periciaId}/emitir-laudo/prova`, antiForgery, {
                            conteudo: content.value,
                            operation: signedOperation
                        });
                        window.location.assign(result.redirectUrl);
                    } catch (exception) {
                        password.value = '';
                        status.textContent = '';
                        error.textContent = exception.message;
                        error.hidden = false;
                        error.focus();
                    } finally {
                        button.disabled = false;
                        form.removeAttribute('aria-busy');
                    }
                });
            });

            document.querySelectorAll('[data-operacao-assinada-form]').forEach((form) => {
                const button = form.querySelector('button[type="submit"]');
                const password = form.querySelector('[name="SenhaWallet"]');
                const pairing = form.querySelector('[name="CodigoPareamento"]');
                const justification = form.querySelector('[name="Justificativa"]');
                const type = form.querySelector('[name="Tipo"]');
                const quantity = form.querySelector('[name="QuantidadeDescrita"]');
                const resultLabel = form.querySelector('[name="RotuloEvidenciaResultante"]');
                const resultDescription = form.querySelector('[name="DescricaoResultante"]');
                const status = form.querySelector('[data-operacao-status]');
                const error = form.querySelector('[data-operacao-error]');
                const antiForgery = form.querySelector('input[name="__RequestVerificationToken"]').value;
                let signedOperation = null;

                justification?.addEventListener('input', () => {
                    signedOperation = null;
                    password.required = true;
                    pairing.required = true;
                });
                type?.addEventListener('change', () => {
                    signedOperation = null;
                    password.required = true;
                    pairing.required = true;
                });
                quantity?.addEventListener('input', () => {
                    signedOperation = null;
                    password.required = true;
                    pairing.required = true;
                });
                [resultLabel, resultDescription].forEach((input) => input?.addEventListener('input', () => {
                    signedOperation = null;
                    password.required = true;
                    pairing.required = true;
                }));
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    error.hidden = true;
                    if ((!justification || justification.value.trim()) && (!signedOperation && (!password.value || !pairing.value))) {
                        error.textContent = 'Informe a senha e o código de pareamento da wallet.';
                        error.hidden = false;
                        error.focus();
                        return;
                    }
                    if (justification && !justification.value.trim()) {
                        error.textContent = 'Informe a justificativa da operação.';
                        error.hidden = false;
                        error.focus();
                        return;
                    }

                    button.disabled = true;
                    form.setAttribute('aria-busy', 'true');
                    try {
                        const payload = {
                            ...(justification ? { justificativa: justification.value } : {}),
                            ...(type ? { tipo: type.value } : {}),
                            ...(quantity ? { quantidadeDescrita: quantity.value } : {}),
                            ...(resultLabel ? { rotuloEvidenciaResultante: resultLabel.value } : {}),
                            ...(resultDescription ? { descricaoResultante: resultDescription.value } : {})
                        };
                        if (!signedOperation) {
                            status.textContent = 'Preparando a operação para assinatura.';
                            const command = await post(form.dataset.prepararUrl, antiForgery, payload);
                            status.textContent = 'Aguardando a assinatura na wallet.';
                            const walletResponse = await fetch(`${command.walletEndpoint}/v1/proofs/signed-operation`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', 'X-Wallet-Pairing-Token': pairing.value },
                                body: JSON.stringify({ did: command.signerDid, password: password.value, operation: command.operation })
                            });
                            const wallet = await walletResponse.json().catch(() => ({}));
                            if (!walletResponse.ok) throw new Error(wallet.message || 'A wallet recusou a assinatura da operação.');
                            signedOperation = wallet.operation;
                            password.value = '';
                            password.required = false;
                            pairing.required = false;
                        }

                        status.textContent = 'Confirmando a autorização no ledger.';
                        const result = await post(form.dataset.concluirUrl, antiForgery, { ...payload, operation: signedOperation });
                        window.location.assign(result.redirectUrl);
                    } catch (exception) {
                        password.value = '';
                        status.textContent = '';
                        error.textContent = exception.message;
                        error.hidden = false;
                        error.focus();
                    } finally {
                        button.disabled = false;
                        form.removeAttribute('aria-busy');
                    }
                });
            });
        })();
    </script>
}

@section Styles {
    <style>
        .pagina-cabecalho { margin-bottom: 1.5rem; }
        .pagina-cabecalho h1 { margin-bottom: 0.25rem; }

        .painel-vazio {
            border: 1px dashed var(--cor-borda-forte);
            border-radius: var(--raio);
            padding: 2rem 1.5rem;
            text-align: center;
            color: var(--cor-texto-suave);
        }

        .painel-vazio-icone {
            display: inline-flex;
            color: var(--cor-texto-fraco);
            margin-bottom: 0.5rem;
        }

        .lista-recebimento {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            max-width: 720px;
        }

        .item-recebimento { padding: 1.25rem 1.5rem; }

        .item-recebimento-cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }

        .item-recebimento-rotulo { font-weight: 600; font-size: 1rem; }

        .item-recebimento-descricao {
            margin: 0.125rem 0 0;
            color: var(--cor-texto-suave);
            font-size: 0.875rem;
        }

        .formulario-inline {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-width: 420px;
        }

        .campo-inline { margin-bottom: 0; }

        .campo-textarea {
            height: auto;
            padding: 0.625rem 0.75rem;
            resize: vertical;
            font-family: inherit;
        }

        .operacao-amostra-detalhes {
            border-top: 1px solid var(--cor-borda);
            padding-top: 0.75rem;
            margin-top: 0.75rem;
        }

        .operacao-amostra-detalhes summary {
            cursor: pointer;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--cor-texto-suave);
        }

        .operacao-amostra-detalhes .formulario-inline {
            margin-top: 0.75rem;
        }
    </style>
}
