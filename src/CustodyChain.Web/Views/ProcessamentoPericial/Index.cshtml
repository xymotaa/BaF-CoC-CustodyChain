@model CustodyChain.Web.Models.ViewModels.ProcessamentoPericialListaViewModel
@{ ViewData["Title"] = "Processamento pericial"; }

<div class="pagina-cabecalho-acao"><div><h1>Processamento pericial</h1><p class="campo-ajuda">Vestígios designados a você. Receba e rompa o lacre para liberar o exame.</p></div></div>
@if (TempData["MensagemSucesso"] is string sucesso) { <div class="alerta alerta-sucesso" role="status"><span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span><span>@sucesso</span></div> }
@if (TempData["MensagemErro"] is string erro) { <div class="alerta alerta-erro" role="alert"><span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span><span>@erro</span></div> }

@if (Model.Pericias.Count == 0)
{
    <div class="painel-vazio"><span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-pericia" /></svg></span><p>Nenhuma perícia designada a você no momento.</p></div>
}
else
{
    <div class="lista-operacional lista-processamento">
        @foreach (var item in Model.Pericias) { <partial name="_PericiaCard" model="item" /> }
    </div>
}

@section Scripts { <script src="~/js/ui/processamento-pericial.js" asp-append-version="true"></script> }
