@model CustodyChain.Web.Models.ViewModels.ItemPericiaViewModel
<section class="cartao item-operacional item-processamento" aria-labelledby="pericia-@Model.PericiaId-titulo">
    <div class="item-operacional-cabecalho"><div><h2 id="pericia-@Model.PericiaId-titulo" class="mono item-operacional-rotulo">@Model.RotuloEvidencia</h2><p class="item-operacional-descricao">@Model.Descricao</p></div><span class="selo" aria-label="Situação da perícia: @Model.Situacao">@Model.Situacao</span></div>
    <dl class="detalhes-operacionais">
        <div><dt>Identificador do vestígio</dt><dd class="codigo-forense mono">@Model.VestigioId</dd></div><div><dt>Conjunto</dt><dd class="codigo-forense mono">@Model.RotuloConjunto</dd></div><div><dt>Lacre atual</dt><dd class="codigo-forense mono">@(Model.NumeroLacreAtual ?? "Não informado")</dd></div><div><dt>Responsável</dt><dd>Você, perito designado</dd></div><div><dt>Permissão</dt><dd>@(Model.CredencialPermissaoValida ? "Vigente" : "Pendente ou inválida")</dd></div><div><dt>Situação do lacre</dt><dd>@(Model.LacreRompido ? "Rompido" : "Íntegro")</dd></div>
    </dl>
    @if (!Model.CredencialPermissaoValida) { <div class="alerta alerta-erro" role="alert"><span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span><span>Credencial de permissão inválida para este vestígio (RN10). Rompimento bloqueado.</span></div> }
    @if (Model.Situacao == "DESIGNADA")
    {
        <form class="formulario-operacao-pericial" data-operacao-assinada-form data-pericia-id="@Model.PericiaId" data-preparar-url="/processamento-pericial/@Model.PericiaId/receber/comando" data-concluir-url="/processamento-pericial/@Model.PericiaId/receber/prova">
            @Html.AntiForgeryToken()<fieldset><legend>Receber vestígio</legend><p class="campo-ajuda">A assinatura confirma o recebimento e inicia a guarda pericial.</p><div class="grade-operacional"><div class="campo"><label class="campo-rotulo" for="receber-senha-@Model.PericiaId">Senha da wallet</label><input id="receber-senha-@Model.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required /></div><div class="campo"><label class="campo-rotulo" for="receber-pareamento-@Model.PericiaId">Código de pareamento</label><input id="receber-pareamento-@Model.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required /></div></div><button type="submit" class="botao botao-primario">Assinar e receber vestígio</button></fieldset><p class="estado-operacao" data-operacao-status role="status" aria-atomic="true"></p><div class="alerta alerta-erro" data-operacao-error role="alert" tabindex="-1" hidden></div>
        </form>
    }
    else if (Model.Situacao == "RECEBIDA")
    {
        <form class="formulario-operacao-pericial" data-operacao-assinada-form data-pericia-id="@Model.PericiaId" data-preparar-url="/processamento-pericial/@Model.PericiaId/romper-lacre/comando" data-concluir-url="/processamento-pericial/@Model.PericiaId/romper-lacre/prova">
            @Html.AntiForgeryToken()<fieldset><legend>Romper lacre</legend><p class="campo-ajuda">Justifique o rompimento antes de assinar a operação.</p><div class="grade-operacional"><div class="campo"><label class="campo-rotulo" for="lacre-justificativa-@Model.PericiaId">Justificativa do rompimento (lacre @Model.NumeroLacreAtual)</label><input id="lacre-justificativa-@Model.PericiaId" name="Justificativa" class="campo-entrada" required /></div><div class="campo"><label class="campo-rotulo" for="lacre-senha-@Model.PericiaId">Senha da wallet</label><input id="lacre-senha-@Model.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required /></div><div class="campo"><label class="campo-rotulo" for="lacre-pareamento-@Model.PericiaId">Código de pareamento</label><input id="lacre-pareamento-@Model.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required /></div></div><button type="submit" class="botao botao-primario" @(Model.CredencialPermissaoValida ? "" : "disabled")>Assinar e romper lacre</button></fieldset><p class="estado-operacao" data-operacao-status role="status" aria-atomic="true"></p><div class="alerta alerta-erro" data-operacao-error role="alert" tabindex="-1" hidden></div>
        </form>
    }
    else if (Model.Situacao == "EM_EXECUCAO")
    {
        <details class="operacao-amostra-detalhes"><summary>Fracionar amostra</summary><form class="formulario-operacao-pericial" data-operacao-assinada-form data-pericia-id="@Model.PericiaId" data-preparar-url="/processamento-pericial/@Model.PericiaId/fracionar/comando" data-concluir-url="/processamento-pericial/@Model.PericiaId/fracionar/prova">@Html.AntiForgeryToken()<fieldset><legend>Dados do fracionamento</legend><div class="grade-operacional"><div class="campo"><label class="campo-rotulo" for="rotulo-resultante-@Model.PericiaId">Rótulo de evidência do item resultante</label><input id="rotulo-resultante-@Model.PericiaId" name="RotuloEvidenciaResultante" class="campo-entrada mono" required /></div><div class="campo"><label class="campo-rotulo" for="descricao-resultante-@Model.PericiaId">Descrição do item resultante</label><input id="descricao-resultante-@Model.PericiaId" name="DescricaoResultante" class="campo-entrada" required /></div><div class="campo"><label class="campo-rotulo" for="quantidade-fracionamento-@Model.PericiaId">Quantidade descrita</label><input id="quantidade-fracionamento-@Model.PericiaId" name="QuantidadeDescrita" class="campo-entrada" /></div><div class="campo"><label class="campo-rotulo" for="justificativa-fracionamento-@Model.PericiaId">Justificativa</label><input id="justificativa-fracionamento-@Model.PericiaId" name="Justificativa" class="campo-entrada" required /></div><div class="campo"><label class="campo-rotulo" for="senha-fracionamento-@Model.PericiaId">Senha da wallet</label><input id="senha-fracionamento-@Model.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required /></div><div class="campo"><label class="campo-rotulo" for="pareamento-fracionamento-@Model.PericiaId">Código de pareamento</label><input id="pareamento-fracionamento-@Model.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required /></div></div><button type="submit" class="botao botao-secundario">Assinar e fracionar</button></fieldset><p class="estado-operacao" data-operacao-status role="status" aria-atomic="true"></p><div class="alerta alerta-erro" data-operacao-error role="alert" tabindex="-1" hidden></div></form></details>
        <details class="operacao-amostra-detalhes"><summary>Unificar com outro vestígio do mesmo conjunto (RC: @Model.RotuloConjunto)</summary><form class="formulario-operacao-pericial" data-operacao-assinada-form data-pericia-id="@Model.PericiaId" data-preparar-url="/processamento-pericial/@Model.PericiaId/unificar/comando" data-concluir-url="/processamento-pericial/@Model.PericiaId/unificar/prova">@Html.AntiForgeryToken()<fieldset><legend>Dados da unificação</legend><div class="grade-operacional"><div class="campo"><label class="campo-rotulo" for="origens-unificacao-@Model.PericiaId">ID do(s) outro(s) vestígio(s) de origem, separados por vírgula</label><input id="origens-unificacao-@Model.PericiaId" name="OutrosVestigiosOrigemIds" class="campo-entrada mono" placeholder="ex.: 6, 7" required /></div><div class="campo"><label class="campo-rotulo" for="rotulo-unificacao-@Model.PericiaId">Rótulo de evidência do item unificado</label><input id="rotulo-unificacao-@Model.PericiaId" name="RotuloEvidenciaResultante" class="campo-entrada mono" required /></div><div class="campo"><label class="campo-rotulo" for="descricao-unificacao-@Model.PericiaId">Descrição do item unificado</label><input id="descricao-unificacao-@Model.PericiaId" name="DescricaoResultante" class="campo-entrada" required /></div><div class="campo"><label class="campo-rotulo" for="justificativa-unificacao-@Model.PericiaId">Justificativa</label><input id="justificativa-unificacao-@Model.PericiaId" name="Justificativa" class="campo-entrada" required /></div><div class="campo"><label class="campo-rotulo" for="senha-unificacao-@Model.PericiaId">Senha da wallet</label><input id="senha-unificacao-@Model.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required /></div><div class="campo"><label class="campo-rotulo" for="pareamento-unificacao-@Model.PericiaId">Código de pareamento</label><input id="pareamento-unificacao-@Model.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required /></div></div><button type="submit" class="botao botao-secundario">Assinar e unificar</button></fieldset><p class="estado-operacao" data-operacao-status role="status" aria-atomic="true"></p><div class="alerta alerta-erro" data-operacao-error role="alert" tabindex="-1" hidden></div></form></details>
        <details class="operacao-amostra-detalhes"><summary>Registrar consumo ou exaurimento</summary><form class="formulario-operacao-pericial" data-operacao-assinada-form data-pericia-id="@Model.PericiaId" data-preparar-url="/processamento-pericial/@Model.PericiaId/consumir-exaurir/comando" data-concluir-url="/processamento-pericial/@Model.PericiaId/consumir-exaurir/prova">@Html.AntiForgeryToken()<fieldset><legend>Dados da operação</legend><div class="grade-operacional"><div class="campo"><label class="campo-rotulo" for="amostra-tipo-@Model.PericiaId">Tipo</label><select id="amostra-tipo-@Model.PericiaId" name="Tipo" class="campo-entrada"><option value="CONSUMO">Consumo</option><option value="EXAURIMENTO">Exaurimento</option></select></div><div class="campo"><label class="campo-rotulo" for="amostra-quantidade-@Model.PericiaId">Quantidade descrita</label><input id="amostra-quantidade-@Model.PericiaId" name="QuantidadeDescrita" class="campo-entrada" /></div><div class="campo"><label class="campo-rotulo" for="amostra-justificativa-@Model.PericiaId">Justificativa</label><input id="amostra-justificativa-@Model.PericiaId" name="Justificativa" class="campo-entrada" required /></div><div class="campo"><label class="campo-rotulo" for="amostra-senha-@Model.PericiaId">Senha da wallet</label><input id="amostra-senha-@Model.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required /></div><div class="campo"><label class="campo-rotulo" for="amostra-pareamento-@Model.PericiaId">Código de pareamento</label><input id="amostra-pareamento-@Model.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required /></div></div><button type="submit" class="botao botao-secundario">Assinar e registrar</button></fieldset><p class="estado-operacao" data-operacao-status role="status" aria-atomic="true"></p><div class="alerta alerta-erro" data-operacao-error role="alert" tabindex="-1" hidden></div></form></details>
        <form class="formulario-operacao-pericial formulario-laudo" data-laudo-form data-pericia-id="@Model.PericiaId" data-preparar-url="/processamento-pericial/@Model.PericiaId/emitir-laudo/comando" data-concluir-url="/processamento-pericial/@Model.PericiaId/emitir-laudo/prova">@Html.AntiForgeryToken()<fieldset><legend>Emitir laudo</legend><div class="campo"><label class="campo-rotulo" for="laudo-conteudo-@Model.PericiaId">Conteúdo do laudo</label><textarea id="laudo-conteudo-@Model.PericiaId" name="Conteudo" rows="4" class="campo-entrada campo-textarea" required></textarea></div><div class="grade-operacional"><div class="campo"><label class="campo-rotulo" for="laudo-senha-@Model.PericiaId">Senha da wallet</label><input id="laudo-senha-@Model.PericiaId" name="SenhaWallet" type="password" class="campo-entrada" autocomplete="current-password" required /></div><div class="campo"><label class="campo-rotulo" for="laudo-pareamento-@Model.PericiaId">Código de pareamento</label><input id="laudo-pareamento-@Model.PericiaId" name="CodigoPareamento" type="password" class="campo-entrada" autocomplete="off" required /></div></div><button type="submit" class="botao botao-primario">Assinar e emitir laudo</button></fieldset><p class="estado-operacao" data-laudo-status role="status" aria-atomic="true"></p><div class="alerta alerta-erro" data-laudo-error role="alert" tabindex="-1" hidden></div></form>
    }
</section>
