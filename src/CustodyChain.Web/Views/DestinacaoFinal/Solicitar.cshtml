@model CustodyChain.Web.Models.ViewModels.SolicitarDestinacaoViewModel
@{
    ViewData["Title"] = "Destinação final";
}

<div class="pagina-cabecalho">
    <h1>Destinação final</h1>
</div>

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagem</span>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>Verifique os campos destacados abaixo.</span>
    </div>
}

@if (Model.VestigiosDisponiveis.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-descarte" /></svg></span>
        <p>Nenhum vestígio elegível para destinação final (Armazenado ou Periciado).</p>
    </div>
}
else
{
    <form asp-controller="DestinacaoFinal" asp-action="Solicitar" method="post" enctype="multipart/form-data" novalidate class="formulario-vestigio">
        @Html.AntiForgeryToken()

        <section class="cartao secao-formulario">
            <div class="grade-campos grade-2col">
                <div class="campo">
                    <label asp-for="VestigioId" class="campo-rotulo"></label>
                    <select asp-for="VestigioId" class="campo-entrada @(ViewData.ModelState["VestigioId"]?.Errors.Count > 0 ? "campo-invalido" : "")">
                        <option value="">Selecione o vestígio</option>
                        @foreach (var opcao in Model.VestigiosDisponiveis)
                        {
                            <option value="@opcao.Id">@opcao.RotuloEvidencia — @opcao.Descricao</option>
                        }
                    </select>
                    <span asp-validation-for="VestigioId" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="Tipo" class="campo-rotulo"></label>
                    <select asp-for="Tipo" class="campo-entrada">
                        <option value="DESCARTE">Descarte</option>
                        <option value="RESTITUICAO">Restituição</option>
                    </select>
                    <span asp-validation-for="Tipo" class="campo-erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="DidMagistrado" class="campo-rotulo"></label>
                    <input asp-for="DidMagistrado" class="campo-entrada mono @(ViewData.ModelState["DidMagistrado"]?.Errors.Count > 0 ? "campo-invalido" : "")" placeholder="did:legal:judge:..." />
                    <span asp-validation-for="DidMagistrado" class="campo-erro"></span>
                </div>
            </div>

            <div class="campo">
                <label asp-for="ArquivoAutorizacao" class="campo-rotulo"></label>
                <div class="campo-arquivo">
                    <input asp-for="ArquivoAutorizacao" type="file" class="campo-arquivo-input @(ViewData.ModelState["ArquivoAutorizacao"]?.Errors.Count > 0 ? "campo-invalido" : "")" data-campo-arquivo-input />
                    <label for="ArquivoAutorizacao" class="botao botao-secundario botao-altura-campo campo-arquivo-botao">Escolher arquivo</label>
                    <span class="campo-arquivo-nome" data-campo-arquivo-nome data-placeholder="Nenhum arquivo selecionado">Nenhum arquivo selecionado</span>
                </div>
                <span class="campo-ajuda">Mandado judicial em PDF ou imagem. Armazenado com verificação de integridade.</span>
                <span asp-validation-for="ArquivoAutorizacao" class="campo-erro"></span>
            </div>

            <div class="campo">
                <label asp-for="Observacao" class="campo-rotulo"></label>
                <textarea asp-for="Observacao" rows="3" class="campo-entrada campo-textarea"></textarea>
                <span asp-validation-for="Observacao" class="campo-erro"></span>
            </div>

            <div class="grade-campos grade-2col assinatura-wallet">
                <div class="campo">
                    <label class="campo-rotulo" for="wallet-pairing">Token de pareamento da wallet</label>
                    <input id="wallet-pairing" type="password" class="campo-entrada" autocomplete="off" />
                </div>
                <div class="campo">
                    <label class="campo-rotulo" for="wallet-password">Senha da wallet</label>
                    <input id="wallet-password" type="password" class="campo-entrada" autocomplete="current-password" />
                </div>
            </div>
            <p class="campo-ajuda">A solicitação só será registrada após sua assinatura na wallet e confirmação no ledger.</p>
            <p class="campo-erro" data-erro-assinatura role="alert"></p>
            <p class="campo-ajuda" data-status-assinatura role="status"></p>
        </section>

        <div class="formulario-acoes">
            <button type="submit" class="botao botao-primario">Solicitar destinação final</button>
        </div>
    </form>
}

@section Styles {
    <style>
        .pagina-cabecalho { margin-bottom: 1.5rem; }
        .pagina-cabecalho h1 { margin-bottom: 0.25rem; }

        .formulario-vestigio {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .secao-formulario {
            padding: 1.125rem 1.25rem;
            font-size: 0.9rem;
            box-shadow: none;
        }

        .grade-campos { display: grid; gap: 0 1rem; }
        .grade-2col { grid-template-columns: 1fr 1fr; }

        @@media (max-width: 640px) {
            .grade-2col { grid-template-columns: 1fr; }
        }

        .campo-textarea {
            height: auto;
            padding: 0.625rem 0.75rem;
            resize: none;
            font-family: inherit;
        }

        .campo-arquivo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .campo-arquivo-botao {
            flex-shrink: 0;
            cursor: pointer;
        }

        .campo-arquivo-nome {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.875rem;
            color: var(--cor-texto-fraco);
        }

        .campo-arquivo-input {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .campo-arquivo-input.campo-invalido ~ .campo-arquivo-nome {
            color: var(--cor-erro);
        }

        .formulario-acoes { display: flex; justify-content: flex-end; }
        .assinatura-wallet { margin-top: 0.5rem; }

        .painel-vazio {
            border: 1px dashed var(--cor-borda-forte);
            border-radius: var(--raio);
            padding: 2rem 1.5rem;
            text-align: center;
            color: var(--cor-texto-suave);
        }

        .painel-vazio-icone {
            display: inline-flex;
            color: var(--cor-texto-fraco);
            margin-bottom: 0.5rem;
        }

        .painel-vazio p { margin: 0 auto 0.25rem; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var entrada = document.querySelector('[data-campo-arquivo-input]');
            var nome = document.querySelector('[data-campo-arquivo-nome]');
            var formulario = document.querySelector('.formulario-vestigio');
            var erro = document.querySelector('[data-erro-assinatura]');
            var status = document.querySelector('[data-status-assinatura]');
            var pairing = document.getElementById('wallet-pairing');
            var password = document.getElementById('wallet-password');
            if (!entrada || !nome || !formulario || !erro || !status || !pairing || !password) return;

            entrada.addEventListener('change', function () {
                nome.textContent = entrada.files.length > 0 ? entrada.files[0].name : nome.dataset.placeholder;
            });

            async function responseJson(response) {
                var body = await response.json().catch(function () { return {}; });
                if (!response.ok) throw new Error(body.message || 'Não foi possível concluir a solicitação.');
                return body;
            }

            async function postProof(url, body) {
                var token = formulario.querySelector('input[name="__RequestVerificationToken"]');
                return responseJson(await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token.value },
                    body: JSON.stringify(body)
                }));
            }

            formulario.addEventListener('submit', async function (event) {
                event.preventDefault();
                erro.textContent = '';
                status.textContent = '';
                try {
                    status.textContent = 'Enviando autorização e preparando a solicitação.';
                    var command = await responseJson(await fetch('/destinacao-final/solicitar/comando', {
                        method: 'POST', body: new FormData(formulario)
                    }));
                    status.textContent = 'Aguardando assinatura na wallet.';
                    var walletResponse = await fetch(command.walletEndpoint + '/v1/proofs/signed-operation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Wallet-Pairing-Token': pairing.value },
                        body: JSON.stringify({ did: command.signerDid, password: password.value, operation: command.operation })
                    });
                    var wallet = await responseJson(walletResponse);
                    password.value = '';
                    status.textContent = 'Confirmando a solicitação no ledger.';
                    var result = await postProof('/destinacao-final/solicitar/prova', {
                        vestigioId: Number(document.getElementById('VestigioId').value), operation: wallet.operation
                    });
                    window.location.assign(result.redirectUrl);
                } catch (exception) {
                    password.value = '';
                    status.textContent = '';
                    erro.textContent = exception.message;
                }
            });
        })();
    </script>
}
