@model IReadOnlyList<CustodyChain.Web.Models.ViewModels.ItemDestinacaoViewModel>
@{
    ViewData["Title"] = "Aprovar destinação final";
}

<div class="pagina-cabecalho pagina-cabecalho-acoes">
    <div><h1>Aprovar destinação final</h1></div>
    <nav class="navegacao-operacional" aria-label="Navegação da cadeia de custódia">
        <a href="/auditoria" class="botao botao--secundario">Consultar histórico</a>
    </nav>
</div>

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagemSucesso</span>
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>@mensagemErro</span>
    </div>
}

@if (Model.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-descarte" /></svg></span>
        <p>Nenhuma destinação final pendente de aprovação.</p>
    </div>
}
else
{
    <div class="lista-recebimento lista-operacional">
        @foreach (var item in Model)
        {
            <section class="cartao item-recebimento item-operacional">
                <div class="item-recebimento-cabecalho item-operacional-cabecalho">
                    <div>
                        <span class="mono item-recebimento-rotulo item-operacional-rotulo">@item.RotuloEvidencia</span>
                        <p class="item-recebimento-descricao item-operacional-descricao">Solicitado por @item.SolicitanteNome</p>
                    </div>
                    <span class="selo">@item.Tipo</span>
                </div>

                <dl class="item-recebimento-detalhes detalhes-operacionais">
                    <div>
                        <dt>DID do magistrado</dt>
                        <dd class="mono">@item.DidMagistrado</dd>
                    </div>
                    <div>
                        <dt>Mandado anexado</dt>
                        <dd>Anexo #@item.AnexoId</dd>
                    </div>
                    <div>
                        <dt>Observação</dt>
                        <dd>@(item.Observacao ?? "—")</dd>
                    </div>
                </dl>

                <div class="item-recebimento-acoes">
                    <a href="/destinacao-final/solicitar" class="botao botao--secundario">Nova solicitação</a>
                    <form class="formulario-aprovacao formulario-aprovacao--inline" data-descarte-id="@item.DescarteId">
                        @Html.AntiForgeryToken()
                        <label class="sr-only" for="wallet-pairing-@item.DescarteId">Token de pareamento da wallet</label>
                        <input id="wallet-pairing-@item.DescarteId" data-wallet-pairing type="password" class="campo-entrada campo-compacto" placeholder="Token da wallet" autocomplete="off" required />
                        <label class="sr-only" for="wallet-password-@item.DescarteId">Senha da wallet</label>
                        <input id="wallet-password-@item.DescarteId" data-wallet-password type="password" class="campo-entrada campo-compacto" placeholder="Senha da wallet" autocomplete="current-password" required />
                        <button type="submit" class="botao botao--primario">Aprovar e executar</button>
                    </form>
                </div>
                <p class="campo-erro" data-erro-aprovacao role="alert" tabindex="-1" hidden></p>
                <p class="campo-ajuda estado-operacao" data-status-aprovacao role="status" aria-live="polite"></p>
            </section>
        }
    </div>
}


@section Scripts {
    <script>
        (function () {
            var walletUi = window.CustodyChainWallet;
            if (!walletUi) return;

            document.querySelectorAll('.formulario-aprovacao').forEach(function (formulario) {
                formulario.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    var erro = formulario.parentElement.parentElement.querySelector('[data-erro-aprovacao]');
                    var status = formulario.parentElement.parentElement.querySelector('[data-status-aprovacao]');
                    var token = formulario.querySelector('input[name="__RequestVerificationToken"]').value;
                    var pairing = formulario.querySelector('[data-wallet-pairing]');
                    var password = formulario.querySelector('[data-wallet-password]');
                    var button = formulario.querySelector('button[type="submit"]');
                    var descarteId = Number(formulario.dataset.descarteId);
                    walletUi.limparErro(erro);
                    if (!formulario.checkValidity()) { formulario.reportValidity(); return; }

                    walletUi.definirProcessamento({ botao: button, painel: formulario, processando: true });
                    try {
                        walletUi.definirStatus(status, 'Preparando a aprovação.', 'processando');
                        var command = await walletUi.requisicaoAplicacao({
                            url: '/destinacao-final/aprovar/comando', token: token, body: { descarteId: descarteId },
                            mensagemErro: 'Não foi possível preparar a aprovação.'
                        });
                        walletUi.definirStatus(status, 'Aguardando assinatura administrativa na wallet.', 'aguardando');
                        var assinatura = await walletUi.requisicaoWallet({
                            endpoint: command.walletEndpoint, path: '/v1/proofs/signed-operation', pairingToken: pairing.value,
                            body: { did: command.signerDid, password: password.value, operation: command.operation },
                            mensagemErro: 'A wallet recusou a assinatura.'
                        });
                        walletUi.limparCamposSensíveis(password, pairing);
                        walletUi.definirStatus(status, 'Confirmando a aprovação no ledger.', 'processando');
                        var result = await walletUi.requisicaoAplicacao({
                            url: '/destinacao-final/aprovar/prova', token: token,
                            body: { descarteId: descarteId, operation: assinatura.operation },
                            mensagemErro: 'Não foi possível concluir a aprovação.'
                        });
                        window.location.assign(result.redirectUrl);
                    } catch (exception) {
                        walletUi.limparCamposSensíveis(password, pairing);
                        walletUi.definirStatus(status, '', 'erro');
                        walletUi.exibirErro(erro, exception.message);
                    } finally {
                        walletUi.definirProcessamento({ botao: button, painel: formulario, processando: false });
                    }
                });
            });
        })();
    </script>
}
