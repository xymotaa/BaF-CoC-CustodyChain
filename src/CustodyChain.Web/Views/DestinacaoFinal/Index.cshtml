@model IReadOnlyList<CustodyChain.Web.Models.ViewModels.ItemDestinacaoViewModel>
@{
    ViewData["Title"] = "Aprovar destinação final";
}

<div class="pagina-cabecalho">
    <h1>Aprovar destinação final</h1>
</div>

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alerta alerta-sucesso" role="status">
        <span class="alerta-icone"><svg><use href="#icone-sucesso" /></svg></span>
        <span>@mensagemSucesso</span>
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alerta alerta-erro" role="alert">
        <span class="alerta-icone"><svg><use href="#icone-alerta" /></svg></span>
        <span>@mensagemErro</span>
    </div>
}

@if (Model.Count == 0)
{
    <div class="painel-vazio">
        <span class="painel-vazio-icone"><svg width="28" height="28"><use href="#icone-descarte" /></svg></span>
        <p>Nenhuma destinação final pendente de aprovação.</p>
    </div>
}
else
{
    <div class="lista-recebimento">
        @foreach (var item in Model)
        {
            <section class="cartao item-recebimento">
                <div class="item-recebimento-cabecalho">
                    <div>
                        <span class="mono item-recebimento-rotulo">@item.RotuloEvidencia</span>
                        <p class="item-recebimento-descricao">Solicitado por @item.SolicitanteNome</p>
                    </div>
                    <span class="selo">@item.Tipo</span>
                </div>

                <dl class="item-recebimento-detalhes">
                    <div>
                        <dt>DID do magistrado</dt>
                        <dd class="mono">@item.DidMagistrado</dd>
                    </div>
                    <div>
                        <dt>Mandado anexado</dt>
                        <dd>Anexo #@item.AnexoId</dd>
                    </div>
                    <div>
                        <dt>Observação</dt>
                        <dd>@(item.Observacao ?? "—")</dd>
                    </div>
                </dl>

                <div class="item-recebimento-acoes">
                    <a href="/destinacao-final/solicitar" class="botao botao-secundario">Nova solicitação</a>
                    <form class="formulario-aprovacao" data-descarte-id="@item.DescarteId">
                        @Html.AntiForgeryToken()
                        <label class="sr-only" for="wallet-pairing-@item.DescarteId">Token de pareamento da wallet</label>
                        <input id="wallet-pairing-@item.DescarteId" data-wallet-pairing type="password" class="campo-entrada campo-compacto" placeholder="Token da wallet" autocomplete="off" />
                        <label class="sr-only" for="wallet-password-@item.DescarteId">Senha da wallet</label>
                        <input id="wallet-password-@item.DescarteId" data-wallet-password type="password" class="campo-entrada campo-compacto" placeholder="Senha da wallet" autocomplete="current-password" />
                        <button type="submit" class="botao botao-primario">Aprovar e executar</button>
                    </form>
                </div>
                <p class="campo-erro" data-erro-aprovacao role="alert"></p>
                <p class="campo-ajuda" data-status-aprovacao role="status"></p>
            </section>
        }
    </div>
}

@section Styles {
    <style>
        .pagina-cabecalho { margin-bottom: 1.5rem; }
        .pagina-cabecalho h1 { margin-bottom: 0.25rem; }

        .painel-vazio {
            border: 1px dashed var(--cor-borda-forte);
            border-radius: var(--raio);
            padding: 2rem 1.5rem;
            text-align: center;
            color: var(--cor-texto-suave);
        }

        .painel-vazio-icone {
            display: inline-flex;
            color: var(--cor-texto-fraco);
            margin-bottom: 0.5rem;
        }

        .lista-recebimento {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .item-recebimento {
            padding: 1.125rem 1.25rem;
            font-size: 0.9rem;
            box-shadow: none;
        }

        .item-recebimento-cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }

        .item-recebimento-rotulo { font-weight: 600; font-size: 1.125rem; }

        .item-recebimento-descricao {
            margin: 0.125rem 0 0;
            color: var(--cor-texto-suave);
            font-size: 0.875rem;
        }

        .item-recebimento-detalhes {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.75rem;
            margin: 0 0 1rem;
            padding: 0.75rem 0;
            border-top: 1px solid var(--cor-borda);
            border-bottom: 1px solid var(--cor-borda);
        }

        .item-recebimento-detalhes dt {
            font-size: 0.75rem;
            color: var(--cor-texto-fraco);
            margin-bottom: 0.125rem;
        }

        .item-recebimento-detalhes dd {
            margin: 0;
            font-size: 0.875rem;
            overflow-wrap: break-word;
        }

        .item-recebimento-acoes {
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
        }

        .formulario-aprovacao { display: flex; gap: 0.5rem; align-items: center; }
        .campo-compacto { width: 10rem; }

        @@media (max-width: 640px) {
            .item-recebimento-detalhes { grid-template-columns: 1fr; }
            .item-recebimento-acoes { flex-wrap: wrap; }
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            async function responseJson(response) {
                var body = await response.json().catch(function () { return {}; });
                if (!response.ok) throw new Error(body.message || 'Não foi possível concluir a aprovação.');
                return body;
            }

            async function postJson(url, token, body) {
                return responseJson(await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(body)
                }));
            }

            document.querySelectorAll('.formulario-aprovacao').forEach(function (formulario) {
                formulario.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    var erro = formulario.parentElement.parentElement.querySelector('[data-erro-aprovacao]');
                    var status = formulario.parentElement.parentElement.querySelector('[data-status-aprovacao]');
                    var token = formulario.querySelector('input[name="__RequestVerificationToken"]').value;
                    var pairing = formulario.querySelector('[data-wallet-pairing]');
                    var password = formulario.querySelector('[data-wallet-password]');
                    var descarteId = Number(formulario.dataset.descarteId);
                    erro.textContent = '';
                    status.textContent = '';
                    try {
                        status.textContent = 'Preparando a aprovação.';
                        var command = await postJson('/destinacao-final/aprovar/comando', token, { descarteId: descarteId });
                        status.textContent = 'Aguardando assinatura administrativa na wallet.';
                        var wallet = await responseJson(await fetch(command.walletEndpoint + '/v1/proofs/signed-operation', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'X-Wallet-Pairing-Token': pairing.value },
                            body: JSON.stringify({ did: command.signerDid, password: password.value, operation: command.operation })
                        }));
                        password.value = '';
                        status.textContent = 'Confirmando a aprovação no ledger.';
                        var result = await postJson('/destinacao-final/aprovar/prova', token, { descarteId: descarteId, operation: wallet.operation });
                        window.location.assign(result.redirectUrl);
                    } catch (exception) {
                        password.value = '';
                        status.textContent = '';
                        erro.textContent = exception.message;
                    }
                });
            });
        })();
    </script>
}
